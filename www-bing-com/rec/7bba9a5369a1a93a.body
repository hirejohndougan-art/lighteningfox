.sb_form.sb_hpsbtools{position:relative}.sb_form.sb_hpsbtools #hpsbtools-drawer{display:grid;align-self:center}.sb_form.sb_hpsbtools .sb_tool{grid-area:sbox;align-self:center;margin:8px;z-index:3}.sb_form.sb_hpsbtools .tool_button_sb{padding:6px;border-radius:50%}.sb_form.sb_hpsbtools .tool_button_sb path{fill:#174ae4}.sb_form.sb_hpsbtools .tool_button_sb #sb_option_icon{display:block;height:24px;width:24px}.sb_form.sb_hpsbtools.c_show_form{grid-template-areas:'sbox text mic cam' 'foot foot foot foot';grid-template-columns:48px minmax(0,1fr) 52px 52px}.sb_form.sb_hpsbtools.c_show_form .sb_form_c{grid-area:text}.sb_form.sb_hpsbtools.c_show_form .mic_cont{justify-self:end}.sb_form.sb_hpsbtools.c_show_form.c_show_keyboard{grid-template-areas:'sbox text mic cam key' 'foot foot foot foot foot';grid-template-columns:48px minmax(0,1fr) 32px 36px 52px}.sb_form.sb_hpsbtools.c_show_form.c_text:focus-within,.sb_form.sb_hpsbtools.c_show_form.as_exp.c_text,.sb_form.sb_hpsbtools.c_show_form.as_show.c_text,.sb_form.sb_hpsbtools.c_show_form[data-state="hastext"],.sb_form.sb_hpsbtools.c_show_form.c_text[data-state="hastext"]{grid-template-areas:'sbox text cam spy' 'foot foot foot foot';grid-template-columns:48px minmax(0,1fr) 52px 52px}.sb_form.sb_hpsbtools.c_show_form.c_text.hp_keep_sbi[data-state="hastext"]{grid-template-areas:'sbox text clr cam spy' 'foot foot foot foot foot';grid-template-columns:48px minmax(0,1fr) 32px 52px 52px}.sb_form.sb_hpsbtools.c_show_form[data-state="hastext"] .camera,.sb_form.sb_hpsbtools.c_show_form[data-state="hastext"] .clear{justify-self:end;margin-inline-end:6px}.sb_form.sb_hpsbtools.hp_keep_sbi.c_show_form[data-state="hastext"] .clear{margin-inline-end:0}.sb_form.sb_hpsbtools.hp_keep_sbi.c_show_form[data-state="hastext"] .camera{justify-self:start}.sb_form.sb_hpsbtools #hpsbtools-spyglass{grid-area:spy}body.b_dark .sb_form.sb_hpsbtools .tool_button_sb path,#bpage.b_drk .sb_form.sb_hpsbtools .tool_button_sb path{fill:#a2b7f4}@media(forced-colors:no