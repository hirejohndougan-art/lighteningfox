/* divider line starts at top left and runs full width */
.ap-games__top::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background-color: #c6c6c6;
  z-index: 1;
}

/* red prompt sits on top of the left side of the line */
.ap-games__prompt {
  position: absolute;
  top: 0;
  left: 0;
  width: 70px;
  height: 8px;
  background-color: #ff1818;
  z-index: 2;
}

.ap-games__title {
  margin: 0;
  font-family: var(--font-list-titles), -apple-system, Arial, Helvetica, Roboto, system-ui, sans-serif;
  font-size: var(--module-title, 1.25rem);
  font-stretch: condensed;
  font-weight: 700;
  letter-spacing: -0.5px;
  line-height: calc(1em + 2px);
  text-transform: uppercase;
}

.ap-games iframe {
  width: 100%;
  display: block;
  border: 0;
}

.ap-games__title a {
  color: inherit;
  text-decoration: none;
}

.ap-games__title a:hover {
  text-decoration: underline;
}
</style>

