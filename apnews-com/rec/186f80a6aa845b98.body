<!-- Admiral: AP targeting + honor-system bypass (v2, 2026-10-05) -->
<script>
  window.admiral("targeting", "pause");

  var targetingReady = false;
  var BYPASS_KEY = 'admiralDonorBypass';

  function getHonorBypass() {
      try {
          return localStorage.getItem(BYPASS_KEY) === 'true' ? 'true' : 'false';
      } catch (e) {
          return 'false';
      }
  }

  function detectWebView() {
      var userAgent = navigator.userAgent || '';

      var isAndroidWebView =
          /wv/.test(userAgent) ||
          (
              /Android/.test(userAgent) &&
              /Version\/[\d.]+/.test(userAgent) &&
              !/Chrome\/[.0-9]* Mobile/.test(userAgent)
          );

      var isIOSWebView =
          (
              /(iPhone|iPod|iPad)/.test(userAgent) &&
              /AppleWebKit/.test(userAgent) &&
              !/Safari/.test(userAgent)
          ) ||
          /(iPhone|iPod|iPad).*AppleWebKit(?!.*Safari)/i.test(userAgent);

      return {
          isWebView: isAndroidWebView || isIOSWebView,
          platform: isAndroidWebView
              ? 'android'
              : (isIOSWebView ? 'ios' : 'web')
      };
  }

  function setupAdmiralAuthTargeting() {

      if (targetingReady) {
          return;
      }

      var webViewInfo = detectWebView();

      if (
          window.Zephr &&
          window.Zephr.accessDetails &&
          window.Zephr.accessDetails.authenticated !== undefined
      ) {

          var isAuthenticated = window.Zephr.accessDetails.authenticated;
          var activeProducts = window.Zephr.accessDetails.activeProducts || [];
          var activeProductsString = activeProducts.length > 0 ? activeProducts.join(',') : 'none';
          var entitlements = window.Zephr.accessDetails.entitlements;
          var has54OJxr = false;

          try {
              has54OJxr = !!entitlements && JSON.stringify(entitlements).indexOf('"54OJxr"') !== -1;
          } catch (e) {
              has54OJxr = false;
          }

          window.admiral("targeting", "set", "authenticated", isAuthenticated.toString());
          window.admiral("targeting", "set", "activeProducts", activeProductsString);
          window.admiral("targeting", "set", "entitled_54OJxr", has54OJxr.toString());
          window.admiral("targeting", "set", "isWebView", webViewInfo.isWebView.toString());
          window.admiral("targeting", "set", "webViewPlatform", webViewInfo.platform);
          window.admiral("targeting", "set", "honorSystemDonor", getHonorBypass());

          window.admiral("targeting", "ready");

          targetingReady = true;

      } else {
          setTimeout(setupAdmiralAuthTargeting, 500);
      }
  }

  setupAdmiralAuthTargeting();

  setTimeout(function() {

      if (!targetingReady) {

          var webViewInfo = detectWebView();

          window.admiral("targeting", "set", "authenticated", "unknown");
          window.admiral("targeting", "set", "activeProducts", "unknown");
          window.admiral("targeting", "set", "entitled_54OJxr", "unknown");
          window.admiral("targeting", "set", "isWebView", webViewInfo.isWebView.toString());
          window.admiral("targeting", "set", "webViewPlatform", webViewInfo.platform);
          window.admiral("targeting", "set", "honorSystemDonor", getHonorBypass());

          window.admiral("targeting", "ready");

          targetingReady = true;
      }

  }, 3000);

  document.addEventListener('click', function(e) {
      var el = e.target;
      var depth = 0;

      while (el && el !== document && depth < 4) {
          var text = (el.textContent || '').replace(/\s+/g, ' ').trim().toLowerCase();

          if (text === 'log in here') {
              try {
                  localStorage.setItem(BYPASS_KEY, 'true');
              } catch (err) {}

              window.admiral("targeting", "set", "honorSystemDonor", "true");

              if (window.dataLayer) {
                  window.dataLayer.push({ event: 'admiral_login_bypass' });
              }
              return;
          }

          el = el.parentNode;
          depth++;
      }
  }, true);
