    window['BSP-view-mode'] = false;
</script><script>
  (function(d, w) {
    function hasFacebookEmbed() {
      return d.querySelector('.fb-post, .fb-video, .fb-like, .fb-share-button, .fb-comments, .fb-page');
    }

    function loadFacebookSdk() {
      if (!hasFacebookEmbed() || d.getElementById('facebook-jssdk')) {
        return;
      }

      var preconnect = d.createElement('link');
      preconnect.rel = 'preconnect';
      preconnect.href = 'https://connect.facebook.net';
      d.head.appendChild(preconnect);

      w.fbAsyncInit = function() {
        FB.init({
          
            appId : '870613919693099',
          
          xfbml : true,
          version : 'v2.9'
        });
      };

      var js = d.createElement('script');
      var fjs = d.getElementsByTagName('script')[0];
      js.id = 'facebook-jssdk';
      js.src = '//connect.facebook.net/en_US/sdk.js';
      fjs.parentNode.insertBefore(js, fjs);
    }

    if (d.readyState === 'loading') {
      d.addEventListener('DOMContentLoaded', loadFacebookSdk);
    } else {
      loadFacebookSdk();
    }
  }(document, window));
</script>
