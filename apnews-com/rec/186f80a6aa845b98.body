--color-primary-navbar-icon-hover: #999 !important;



/* LIGHT COLORS */
--bgDefault--LIGHT: #fff;
--color-primary-text--LIGHT: var(--color-primary-text-theme, #000);
--color-share-button-text--LIGHT: #000;
--color-secondary-button-text--LIGHT: #000;
--color-secondary-button-background--LIGHT: #FFF;
--color-link-text--LIGHT: var(--color-link-text-theme, #0042A9);
--color-link-text-hover--LIGHT: var(--color-link-text-hover-theme, #0042A9);
--module-title-prompt-border--LIGHT: #ccc;
--color-byline-authors--LIGHT: #000;
