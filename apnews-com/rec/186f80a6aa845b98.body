</script><script>(function () {
    var TITLE = 'What is the Fan Poll?'

    var DESC_BOLD =
      'The AP Top 25 Fan Poll lets college football fans predict next week’s rankings.'
    var DESC_REST =
      ' When the next official AP Top 25 comes out, we’ll score your ballot and show you where you rank against other fans.'

    var CONTENT_TITLE = 'How to play:'

    var ITEMS = [
      'Build your next Top 25. Start with this week’s AP Top 25, then reorder, remove or add teams based on what you think will happen to them in next week’s poll.',
      'Submit your prediction. Sign in and submit your ballot by Thursday at 7 p.m. ET. You can come back and update your picks until voting closes.',
      'Share your ballot.',
      'Check the leaderboard after results are posted when the new AP Top 25 is released.',
    ]

    function setText(node, text) {
      if (node && node.textContent !== text) node.textContent = text
    }

    function apply(box) {
      if (!box) return

      setText(box.querySelector('.PollResultsTab-infoBox-title span'), TITLE)

      var desc = box.querySelector('.PollResultsTab-infoBox-description')
      if (desc && desc.getAttribute('data-copy-applied') !== '1') {
        desc.textContent = ''
        var strong = document.createElement('strong')
        strong.textContent = DESC_BOLD
        desc.appendChild(strong)
        desc.appendChild(document.createTextNode(DESC_REST))
        desc.setAttribute('data-copy-applied', '1')
      }

      var ct = box.querySelector('.PollResultsTab-infoBox-content-title')
      if (ct && ct.getAttribute('data-copy-applied') !== '1') {
        ct.textContent = ''
        var ctStrong = document.createElement('strong')
        ctStrong.textContent = CONTENT_TITLE
        ct.appendChild(ctStrong)
        ct.setAttribute('data-copy-applied', '1')
      }

      var items = box.querySelectorAll('.PollResultsTab-infoBox-items-item')
      for (var i = 0; i < items.length && i < ITEMS.length; i++) {
        setText(items[i], ITEMS[i])
      }
    }

    function scan(root) {
      if (!root || root.nodeType !== 1) return
      if (root.matches && root.matches('.PollResultsTab-infoBox-container')) {
        apply(root)
      }
      if (!root.querySelectorAll) return
      var found = root.querySelectorAll('.PollResultsTab-infoBox-container')
      for (var i = 0; i < found.length; i++) apply(found[i])
    }

    function start() {
      scan(document.body)
      new MutationObserver(function (records) {
        for (var i = 0; i < records.length; i++) {
          var added = records[i].addedNodes
          for (var j = 0; j < added.length; j++) scan(added[j])
        }
      }).observe(document.documentElement, { childList: true, subtree: true })
    }

    start()

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        scan(document.body)
      })
    }
  })()</script>
<script>  (function () {
    var TARGET = '/top25PollResult'
    var original = window.fetch
    if (typeof original !== 'function') return
    if (window.__ap400PatchApplied) return
    window.__ap400PatchApplied = true

    window.fetch = function (input, init) {
      var url = ''
      if (typeof input === 'string') {
        url = input
      } else if (input) {
        if (typeof input.url === 'string') url = input.url
      }

      var result = original.apply(this, arguments)
      if (url.indexOf(TARGET) === -1) return result

      return result.then(function (response) {
        if (response) {
          if (response.status === 400) {
            console.warn('[AP patch] top25PollResult 400 treated as 204:', url)
            return new Response(null, { status: 204, statusText: 'No Content' })
          }
        }
        return response
      })
    }
  })()</script>
<script>
