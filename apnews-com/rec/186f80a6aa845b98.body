            <div class="HtmlModule" data-module-tracksubscribe data-gtm-region="Donation Ribbon - Homepage"  data-gtm-topic="No Value"
    
    data-embed-link-behavior="NO_LINK"
    
    
    
>
    
    <a class="AnchorLink" id="html-embed-module-3d0000"></a>


    <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AP News — Donate Promo</title>
<style>
  /* ============================================================
     AP NEWS — DONATE PROMO COMPONENT
     Standalone extract from DES-145 onboarding landing page.
     Self-contained: includes only the tokens this component uses.

     NOTE: AP Var is proprietary. This embed uses fallback stacks.
     Replace font-family values with @font-face declarations for
     AP Var when integrating into the AP codebase.
     ============================================================ */

  :root {
    /* Color tokens */
    --color-neutral-white: #ffffff;
    --color-text-primary: #191919;
    --color-text-inverse-secondary: #e6e6e7;
    --color-brand-ap-solid-red: #da1026;
    --color-backgrounds-primary: #ffffff;
    --color-backgrounds-header-secondary: #3a3a3a;

    /* Spacing tokens */
    --size-08: 8px;
    --size-12: 12px;
    --size-24: 24px;
    --spacing-400: 24px;

    /* Border radius */
    --radius-md: 8px;

    /* Type scale (x-scale) */
    --text-x1: 24px;
    --text-body-base: 18px;
    --text-fixed-md: 16px;

    /* Letter spacing */
    --ls-tight: -0.5px;

    /* Font family — fallback stack; swap for AP Var in prod */
    --font-ap-var: "AP Var", "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  /* Reset */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: var(--font-ap-var);
    color: var(--text-primary);
    background: var(--backgrounds-primary);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ============================================================
     DONATE PROMO
     The section runs full-bleed (edge to edge); only the inner
     content is constrained to the 1280px page frame. The module
     itself remains a contained card.
     ============================================================ */
  .donate-promo {
    background: var(--backgrounds-primary);
    overflow: hidden;
  }
  .donate-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 40px 60px 40px;
  }

  .donation-module {
    background: var(--color-backgrounds-header-secondary);
    border-radius: var(--radius-md);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-400);
  }
  .donation-text {
    flex: 1;
    min-width: 0;
  }
  .donation-text h2 {
    font-size: 23px;
    font-weight: 600;
    line-height: var(--lh-120);
    color: var(--color-neutral-white);
    margin-bottom: 4px;
    font-stretch: 50%;
  }
  .donation-text p {
    font-size: var(--x-base);
    font-weight: 400;
    line-height: var(--lh-body);
    color: var(--color-text-inverse-secondary);
    font-stretch: 100%;
  }

  .btn-donate {
    display: inline-flex;
    align-items: center;
    gap: var(--size-08);
    height: 48px;
    max-height: 48px;
    padding: var(--size-12) var(--size-24);
    background: var(--color-brand-ap-solid-red);
    color: var(--color-neutral-white);
    border: none;
    border-radius: 24px;
    font-family: var(--font-ap-var);
    font-size: 16px;
    font-weight: 530;
    line-height: 1.3;
    font-stretch: 100%;
    letter-spacing: var(--ls-tight);
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    
      
  }
  .btn-donate:hover { opacity: 0.9; }

  /* ============================================================
     RESPONSIVE
     Breakpoints: 1024px (narrow desktop), 768px (tablet — stack),
     560px (mobile — compact).
     ============================================================ */

  /* Narrow desktop: pull in the oversized page inset */
  @media (max-width: 1028px) {
    .donate-inner {
      padding: 40px 48px;
    }
  }

  /* Tablet: stack the CTA below the text, left-aligned */
  @media (max-width: 768px) {
    .donate-inner {
      padding: 32px 24px;
    }
    .donation-module {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
      padding: 20px 16px;
    }
  }

  /* Mobile: compact spacing, content-width CTA */
  @media (max-width: 560px) {
    .donation-text p {
      display: none;
    }
    .donate-inner {
      padding: 20px 16px;
    }
    .btn-donate {
      width: auto;
      align-self: flex-start;
    }
  }
  @media (max-width: 540px) {
    .donation-module {
      padding: 16px 12px;
       gap: 12px;
    }
      .donation-text h2 {
    font-size: 20px;
  }
    }
</style>
</head>
<body>

<!-- =============== DONATE PROMO =============== -->
<section class="donate-promo">
  <div class="donate-inner">
    <div class="donation-module">
      <div class="donation-text">
        <h2>Start our year-end campaign strong</h2>
        <p>We need to raise $1.5 million by December 31st to hit our fundraising goal. Can you support our not-for-profit newsroom today?</p>
      </div>
<a href="https://apnews.com/donate?target=donate_ribbon&ref=EY26-homepage" class="btn-donate">
        Make a year-end gift<span></span>
      </a>
    </div>
  </div>
</section>

