<style>.viafoura {
  --primary-font: 'AP', sans-serif;
  --x-large-font: 3.2; /* 32px changes the large title at top */
  --large-font: 2.0;   /* 20px NOT changing anything*/
  --medium-font: 1.6;  /* 16px changes the headline font in active conversations*/
  --small-font: 1.8;   /* 18px NOT changing anything*/
  --x-small-font: 1.0; /* 10px the small font as the reply to user*/
}

.vf-comment-header {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  width: 100%;
}
/* Hide just the floating bell, everywhere */
vf-tray-trigger[floating],
.vf-tray-trigger--floating {
  display: none !important;
}
.vf-comment-header__heading {
  flex: 1 1 auto !important;
  text-align: left !important;
  margin: 0 !important;
  font-size: 1.2em;
}

.vf-comment-header__actions {
  flex: 0 0 auto !important;
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 8px;
}

.vf-comment-header__actions > * {
  flex: 0 0 auto !important;
}
/* Hide the Profile button/tab in Viafoura comments module */
#vf-tray > div > div > div > div > article > nav > div.vf-horiz-list.vf-tabbed-nav__tabs.vf-flex-grow > div:nth-child(2) {
    display: none;
}
button[data-test="vf-tray-tab-settings"] {
    display: none !important;
}

/* this hides the second start the conversation text in the empty comments area of the below article module */
.vf-ad-empty-comments {
    display: none !important;
}
/* this hides the email sign in the user profile in the tray*/
.vf-client-settings-email-notifications {
  display: none !important;
}

/* Hide the Settings button in Viafoura comments module */
.vf-tray-settings-button,
span.vf-tray-settings-button,
button.vf-tray-settings-button {
    display: none !important;
}

#ap-comments .vf-follow-button {
  display: none !important;
}

.viafoura .vf-badge--accent-color[data-v-2c5d8df2].vf-custom-badge {
   background-color:#ff322e !important;
}
</style>
<style>.PageList-header .title-icon {
  margin-bottom: 10px;
}

bsp-listcarousel .PageList-header .title-icon {
  margin-bottom: 10px;
}

.PageList-header .title-icon picture img {
  height: 30px;
}

@media only screen and (max-width: 1023px) {
  .PageList-header-title {
    padding-top: 24px;
  }

  .PageListStandardB .PageList-header-title {
    padding-top: 24px;
  }
}

@media only screen and (min-width: 1024px) {
  .PageList-header .title-icon {
    margin-bottom: 10px;
    margin-top: 20px;
  }

  bsp-listcarousel .PageList-header .title-icon {
    margin-bottom: 10px;
    margin-top: 20px;
  }
}


@media only screen and (min-width: 1024px) and (max-width: 1439px) {
  .PageListStandardB .PageList-header-title {
    padding-top: 18px;
  }
}

@media only screen and (min-width: 1440px) {
    .PageListStandardB .PageList-header-title {
        padding-top: 18px;
    }

    .PageList-header .title-icon {
      margin-top: 18px;
    }

    bsp-listcarousel .PageList-header .title-icon {
      margin-top: 18px;
    }

}</style>
<style>body {
    --adLabelBuffer: 40px;
    --fsAddBuffer: 40px;
}

[class="FreeStar Advertisement"]:has([id$="rail_sticky"]) {
    position: sticky;
    top: 90px;
}

#apnews_hub_rail_sticky,
#apnews_home_rail_sticky,
#apnews_story_rail_sticky {
    justify-content: start;
}

body[data-tb-dashboard="Homepage"] .apnews_leaderboard {
    max-width: 970px;
    padding-bottom: 20px;
    padding-top: 30px;
}

@media only screen and (max-width: 767px) {
    #apnews_hub_rail_sticky::before {
        content: none;
    }
}

#apnews_hub_rail_small::before,
#apnews_home_rail_sticky::before,
#apnews_story_rail_sticky::before,
#apnews_hub_rail_sticky::before,
#apnews_story_rail_large::before,
[class="apnews_home_feed_dynamic"]::before,
[class="apnews_story_feed_dynamic"]::before,
[class="apnews_hub_mobile"]::before,
[class="apnews_hub_curated"]::before,
[class="apnews_home_mobile_dynamic"]::before,
[class="apnews_hub_feed_dynamic"]::before,
[class="apnews_hub_feed"]::before,
[class="apnews_hub_rail_small"]::before,
[class="apnews_hub_rail"]::before,
[class="apnews_home_mobile"]::before,
[class="apnews_home_curated"]::before,
[class="apnews_home_rail_small"]::before,
[class="apnews_story_rail_large"]::before,
[class="apnews_home_rail_large"]::before,
[class="apnews_home_feed"]::before,
[class="apnews_hub_rail_large"]::before,
[class="apnews_story_feed"]::before,
[class="apnews_home_rail"]::before,
[class="apnews_video_rail"]::before,
[class*="apnews_nativo_backfill"]::before,
[class="fs-feed-ad"]::before {
    content: "Advertisement";
    position: absolute;
    top: -1px;
    padding: 4px 8px;
    font-size: 12px;
    color: #828282;
    text-transform: uppercase;
    font-style: normal;
    z-index: 1;
    --font-1: "AP";
}

[class="apnews_home_feed_dynamic"],
[class*="apnews_nativo_backfill"],
[class="apnews_story_feed_dynamic"],
[class="apnews_hub_curated"],
[class="apnews_hub_mobile"],
[class="apnews_home_mobile_dynamic"],
[class="apnews_hub_feed_dynamic"],
[class="apnews_hub_feed"],
[class="apnews_hub_mobile_dynamic"],
[class="apnews_hub_rail_small"],
[class="apnews_hub_rail"],
[class="apnews_home_mobile"],
[class="apnews_home_curated"],
[class="apnews_home_rail_small"],
[class="apnews_story_rail_large"],
[class="apnews_home_rail_large"],
[class="apnews_home_feed"],
[class="apnews_hub_rail_large"],
[class="apnews_home_rail_sticky"],
[class="apnews_story_feed"],
[class="apnews_home_rail"],
[class="apnews_hub_rail_sticky"],
[class="apnews_video_rail"],
[class="fs-feed-ad"],
#apnews_hub_rail_small,
#apnews_home_rail_sticky,
#apnews_story_rail_large,
#apnews_hub_rail_sticky,
#apnews_story_rail_sticky {
    padding-top: 30px;
    padding-bottom: 10px;
    position: relative;
}

[class="Page-header-leaderboardAd"] > [class="FreeStar Advertisement"] {
    padding-top: 0px;
    padding-bottom: 0px;
    position: relative;
}

[class*="apnews_nativo_backfill"],
[class="apnews_hub_curated"],
[class="apnews_hub_mobile"],
[class="apnews_home_mobile_dynamic"],
[class="apnews_hub_feed_dynamic"],
[class="apnews_hub_feed"],
[class="apnews_hub_mobile_dynamic"],
[class="apnews_story_rail_sticky"],
[class="apnews_hub_rail_small"],
[class="apnews_hub_rail"],
[class="apnews_home_mobile"],
[class="apnews_home_curated"],
[class="apnews_home_rail_small"],
[class="apnews_story_rail_large"],
[class="apnews_home_rail_large"],
[class="apnews_hub_rail_large"],
[class="apnews_home_rail"],
[class="apnews_hub_rail_sticky"],
[class="apnews_video_rail"],
#apnews_story_rail_large,
#apnews_story_rail_sticky,
#apnews_home_rail_sticky,
#apnews_hub_rail_sticky {
    display: flex;
    align-items: center;
    justify-content: unset;
    flex-direction: column;
    min-height: calc(var(--height) + var(--adLabelBuffer));
    height: calc(var(--height) + var(--adLabelBuffer));
    width: 100%;
}

[class="apnews_web_sponsor_logo"] {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    min-height: 75px;
    height: 75px;
    width: 100%;
}

[class="apnews_home_feed_dynamic"],
[class="apnews_story_feed_dynamic"],
[class="apnews_home_feed"],
[class="apnews_story_feed"] {
    display: flex;
    align-items: center;
    justify-content: unset;
    flex-direction: column;
    min-height: calc(var(--height) + var(--adLabelBuffer));
    width: 100%;
}

[class="fs-feed-ad"] {
    display: flex;
    align-items: center;
    justify-content: unset;
    flex-direction: column;
   	min-height: 280px;
}

@media screen and (max-width: 1440px) {
    [class="fs-feed-ad"] {
        display: flex;
        align-items: center;
        justify-content: unset;
        flex-direction: column;
        min-height: calc(var(--height) + var(--adLabelBuffer));
        width: 100%;
    }
}

[class="apnews_hub_feed_dynamic"],
[class="apnews_hub_feed"] {
    min-height: calc(var(--height) + var(--adLabelBuffer));
    height: calc(var(--height) + var(--adLabelBuffer));
}

[class="fs-feed-ad"] {
    --height: 280px;
}

[class="apnews_home_curated"] {
    --height: 280px;
}

[class="apnews_home_feed"] {
    --height: 280px;
}

[class="apnews_home_feed_dynamic"] {
    --height: 280px;
}

[class="apnews_home_mobile"] {
    --height: 280px;
}

[class="apnews_home_mobile_dynamic"] {
    --height: 280px;
}

[class="apnews_home_rail"] {
    --height: 250px;
}

[class="apnews_home_rail_large"] {
    --height: 250px;
}

[class="apnews_home_rail_small"] {
    --height: 250px;
}

[class="apnews_hub_curated"] {
    --height: 280px;
}

[class="apnews_hub_feed"] {
    --height: 280px;
}

[class="apnews_hub_feed_dynamic"] {
    --height: 280px;
}

[class="apnews_hub_mobile"] {
    --height: 280px;
}

[class="apnews_hub_mobile_dynamic"] {
    --height: 280px;
}

[class="apnews_hub_rail"] {
    --height: 250px;
}

[class="apnews_hub_rail_large"] {
    --height: 250px;
}

[class="apnews_hub_rail_small"] {
    --height: 250px;
}

[class="apnews_hub_rail_sticky"] {
    --height: 250px;
}

[class*="apnews_nativo_backfill"] {
    --height: 280px;
}

[class="apnews_story_feed"] {
    --height: 280px;
}

[class="apnews_story_feed_dynamic"] {
    --height: 280px;
}

[class="apnews_story_rail_large"] {
    --height: 250px;
}

@media only screen and (min-width: 1024px) {
    [class="apnews_home_mobile"] {
        display: none;
    }

    [class="apnews_home_mobile_dynamic"] {
        display: none;
    }

    [class="apnews_home_rail"] {
        --height: 600px;
    }

    [class="apnews_home_rail_large"] {
        --height: 600px;
    }

    [class="apnews_home_rail_sticky"] {
        --height: 600px;
    }

    [class="apnews_hub_mobile"] {
        display: none;
    }

    [class="apnews_hub_mobile_dynamic"] {
        display: none;
    }

    [class="apnews_hub_rail"] {
        --height: 600px;
    }

    [class="apnews_hub_rail_large"] {
        --height: 600px;
    }

    [class="apnews_hub_rail_sticky"] {
        --height: 600px;
    }

    [class="apnews_story_rail_large"] {
        --height: 600px;
    }

    [class="apnews_story_rail_sticky"] {
        --height: 600px;
    }

    [class="apnews_video_rail"] {
        --height: 600px;
    }
}

@media screen and (min-width: 767px) {
    .Advertisement:has(> [name="apnews_home_mobile"]),
    .Advertisement:has(> [name="apnews_home_mobile_dynamic"]),
    .Advertisement:has(> [name="apnews_hub_mobile"]),
    .Advertisement:has(> [name="apnews_hub_mobile_dynamic"]),
    [name="apnews_home_mobile"],
    [name="apnews_home_mobile_dynamic"],
    [name="apnews_hub_mobile"],
    [name="apnews_hub_mobile_dynamic"] {
        display: none;
    }
}

@media screen and (min-width: 1440px) {
    [class="fs-feed-ad"] {
        width: 970px;
    }
}

@media screen and (max-width: 767px) {
    [class="fs-feed-ad"] {
        overflow: hidden;
        height: auto; 
    }
}

[class*="apnews_nativo_backfill"] {
    min-width: 102px
}

@media only screen and (max-width: 1023px) {
    #apnews_story_rail_sticky, #apnews_home_rail_sticky, #apnews_hub_rail_sticky {
