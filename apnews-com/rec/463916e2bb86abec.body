  mutation embedConfigBootstrapQueryMutation($id: ID!, $viewerID: String!, $options: JSON) {
    createGameplayForEmbedConfig(id: $id, options: $options) {
      config {
        id
        puzzleTitle
        redirectTo
        puzzleAssetsSha
        themeOverrides
        partner {
          slug
          name
          themeOverrides

          logoLongWhite
          logoLongBlack
          appearance
          navBG
          navFG
          flags
        }
        flags
        hostContext
        hideChrome
        hideCompleteMessages
        googleFontOverride
        paddingBottom
        trackStats
        type
      }

      gameplay {
        additionalTimeAddedSecs
        boardState
        cheatsUsed
        combinedTimeSecs
        completed
        createdAt
        elapsedTimeSecs
        hintsUsed
        id
        metric1
        metric2
        metric3
        metric4
        metricStrings
        ownerID
        pointsAwarded
        resetsUsed
        slug
        viewerOwnsPuzzle

        puzzle {
          id
          name
          emoji
          gameNameOverride
          difficulty
          difficultyPointsCap
          puzzle
          seriesNumber
          viewerMetadata(viewerID: $viewerID)
          team {
            slug
          }

          game {
            id
            stableSlug
            viewerGameVersion {
              id
              label
              featuresArr
              flagsArr
            }
            viewerRuntimeVersion {
              id
              runtimeID
              assetsSha
            }
            assetsBaseURL
            assetsPath
            assetsSha
            cssPath
            devCSSPath
            devJSPath
            displayName
            exposedGlobalFunction
            flagsArr
            jsPath
            slug
          }

          author
          authors {
            id
            name
            username
            usernameID
            publishingName
          }

          editor
          editors {
            id
            name
            username
            usernameID
            publishingName
          }
          mostRecentDaily {
            daily {
              dateKey
            }
          }
        }
      }
      userStateID
      embedSessionToken
    }
  }
`,Et=wt`
  mutation embedConfigCompleteMutation($embedID: String!, $puzzleID: String!, $input: CompleteGamePlayedInput!, $deedValues: [DeedValue!]) {
    gameplayFinishedForEmbedConfig(embedID: $embedID, puzzleID: $puzzleID, input: $input, deedValues: $deedValues) {
      id
      slug
      puzzle {
        id
        name
        emoji
        gameNameOverride
        game {
          slug
        }
      }
    }
  }
`,Dt=wt`
  query embedEndScreenQuery($id: ID!) {
    gamePlay(id: $id) {
      id
      slug
      combinedTimeSecs
      puzzle {
        id
        name
        emoji
        gameNameOverride
        author
        editor
        authors {
          name
          publishingName
          username
        }
        editors {
          name
          publishingName
          username
        }
        game {
          slug
        }
        remix {
          flags
        }
      }
      gameStreak {
        current
        max
        total
        extended
      }
