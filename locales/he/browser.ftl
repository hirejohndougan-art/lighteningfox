# Ironswift — עברית

## תפריט
menu-open-link-new-tab = פתיחת הקישור בלשונית חדשה
menu-copy-link = העתקת כתובת הקישור
menu-open-image-new-tab = פתיחת התמונה בלשונית חדשה
menu-copy-image = העתקת כתובת התמונה
menu-copy = העתקה
menu-back = אחורה
menu-forward = קדימה
menu-reload = טעינה מחדש
menu-select-all = בחירת הכול
menu-find = חיפוש בדף…
menu-save-pdf = שמירה כ־PDF…
menu-print = הדפסה…
menu-view-source = הצגת קוד המקור
menu-inspect = בדיקה

## הורדות
dl-progress = { $pct }% · { $got } מתוך { $total }
dl-so-far = { $got } עד כה
dl-done = הסתיים · { $size } · לחיצה לפתיחה
dl-failed = נכשל: { $error }
dl-cancelled = בוטל
dl-show-all = הצגת כל ההורדות
dl-open-folder = פתיחת תיקיית ההורדות

## הודעות
toast-zoom = תקריב { $pct }%  ·  Ctrl+0 לאיפוס
toast-printed = { $n ->
    [one] נשלח עמוד אחד למדפסת
   *[other] נשלחו { $n } עמודים למדפסת
}
toast-pdf-saved = { $file } ({ $n } עמ׳) נשמר בהורדות
toast-pdf-no-printer = אף מדפסת לא ענתה; { $file } ({ $n } עמ׳) נשמר בהורדות
toast-pdf-failed = לא ניתן לשמור את ה־PDF: { $error }

## חלון ולשוניות
window-loading = טוען את { $target } — Ironswift
private-badge = פרטי

## חיפוש בדף
find-none = אין תוצאות
find-count = { $current } מתוך { $total }
find-hint = Enter: הבא  ·  Shift+Enter: הקודם  ·  Esc: סגירה

## דפי שגיאה
err-try-again = ניסיון חוזר
err-settings = הגדרות
err-details = פרטים
err-dns-title = האתר לא נמצא
err-dns-detail = לא נמצאה כתובת עבור { $host }.
err-dns-tip1 = כדאי לבדוק את איות הכתובת.
err-dns-tip2 = כדאי לבדוק שיש חיבור לאינטרנט.
err-dns-tip3 = ייתכן שהאתר כבר לא קיים.
err-timeout-title = האתר לא ענה בזמן
err-timeout-detail = { $host } לא הגיב בזמן.
err-timeout-tip1 = כדאי לנסות שוב בעוד רגע; ייתכן שהאתר עמוס.
err-net-tip = כדאי לבדוק את החיבור לאינטרנט.
err-cert-title = החיבור הזה אינו מאובטח
err-cert-detail = { $host } שלח אישור אבטחה ש־Ironswift לא יכול לסמוך עליו, ולכן הדף לא נטען. ייתכן שמישהו מנסה לקרוא או לשנות את מה שנשלח.
err-cert-tip1 = אם זה האתר שלך או של החברה שלך, ייתכן שתוקף האישור פג או שהוא לא הותקן.
err-cert-tip2 = אין להזין סיסמאות או פרטי תשלום באתר הזה.
err-refused-title = האתר סירב להתחבר
err-refused-detail = { $host } לא מקבל חיבורים.
err-refused-tip1 = ייתכן שהאתר מושבת או לא פועל בפורט הזה.
err-refused-tip2 = כדאי לנסות שוב מאוחר יותר.
err-proxy-title = לא ניתן להתחבר דרך השרת המתווך
err-proxy-detail = השרת המתווך לא העביר את הבקשה.
err-proxy-tip = כדאי לבדוק את השרת המתווך בהגדרות (רשת).
err-type-title = Ironswift לא יכול להציג את הקובץ הזה
err-type-detail = לא ניתן להציג סוג קובץ כזה בלשונית.
err-other-title = לא ניתן לטעון את הדף
err-other-detail = משהו השתבש בטעינת { $host }.
err-other-tip = כדאי לנסות שוב עם ↻.

## הגדרות
set-language = שפה
set-language-auto = כמו בשולחן העבודה
set-language-hint = לתפריטים ולהודעות של Ironswift, ולשפה שמדווחת לאתרים. נכנס לתוקף מלא בהפעלה הבאה של Ironswift.
set-high-contrast = ניגודיות גבוהה
set-high-contrast-hint = מציג דפים ואת הדפדפן בשחור, לבן וצהוב, ללא תמונות רקע, לקריאה קלה יותר.
