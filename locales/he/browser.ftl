# Ironswift — עברית

## תפריט
menu-open-link-new-tab = פתיחת הקישור בלשונית חדשה
menu-copy-link = העתקת כתובת הקישור
menu-open-image-new-tab = פתיחת התמונה בלשונית חדשה
menu-copy-image = העתקת כתובת התמונה
menu-copy = העתקה
menu-back = אחורה
menu-forward = קדימה
menu-reload = טעינה מחדש
menu-select-all = בחירת הכול
menu-find = חיפוש בדף…
menu-save-pdf = שמירה כ־PDF…
menu-print = הדפסה…
menu-view-source = הצגת קוד המקור
menu-inspect = בדיקה

## הורדות
dl-progress = { $pct }% · { $got } מתוך { $total }
dl-so-far = { $got } עד כה
dl-done = הסתיים · { $size } · לחיצה לפתיחה
dl-failed = נכשל: { $error }
dl-cancelled = בוטל
dl-show-all = הצגת כל ההורדות
dl-open-folder = פתיחת תיקיית ההורדות

## הודעות
toast-zoom = תקריב { $pct }%  ·  Ctrl+0 לאיפוס
toast-printed = { $n ->
    [one] נשלח עמוד אחד למדפסת
   *[other] נשלחו { $n } עמודים למדפסת
}
toast-pdf-saved = { $file } ({ $n } עמ׳) נשמר בהורדות
toast-pdf-no-printer = אף מדפסת לא ענתה; { $file } ({ $n } עמ׳) נשמר בהורדות
toast-pdf-failed = לא ניתן לשמור את ה־PDF: { $error }

## חלון ולשוניות
window-loading = טוען את { $target } — Ironswift
private-badge = פרטי

## חיפוש בדף
find-none = אין תוצאות
find-count = { $current } מתוך { $total }
find-hint = Enter: הבא  ·  Shift+Enter: הקודם  ·  Esc: סגירה

## דפי שגיאה
err-try-again = ניסיון חוזר
err-settings = הגדרות
err-details = פרטים
err-dns-title = האתר לא נמצא
err-dns-detail = לא נמצאה כתובת עבור { $host }.
err-dns-tip1 = כדאי לבדוק את איות הכתובת.
err-dns-tip2 = כדאי לבדוק שיש חיבור לאינטרנט.
err-dns-tip3 = ייתכן שהאתר כבר לא קיים.
err-timeout-title = האתר לא ענה בזמן
err-timeout-detail = { $host } לא הגיב בזמן.
err-timeout-tip1 = כדאי לנסות שוב בעוד רגע; ייתכן שהאתר עמוס.
err-net-tip = כדאי לבדוק את החיבור לאינטרנט.
err-cert-title = החיבור הזה אינו מאובטח
err-cert-detail = { $host } שלח אישור אבטחה ש־Ironswift לא יכול לסמוך עליו, ולכן הדף לא נטען. ייתכן שמישהו מנסה לקרוא או לשנות את מה שנשלח.
err-cert-tip1 = אם זה האתר שלך או של החברה שלך, ייתכן שתוקף האישור פג או שהוא לא הותקן.
err-cert-tip2 = אין להזין סיסמאות או פרטי תשלום באתר הזה.
err-refused-title = האתר סירב להתחבר
err-refused-detail = { $host } לא מקבל חיבורים.
err-refused-tip1 = ייתכן שהאתר מושבת או לא פועל בפורט הזה.
err-refused-tip2 = כדאי לנסות שוב מאוחר יותר.
err-proxy-title = לא ניתן להתחבר דרך השרת המתווך
err-proxy-detail = השרת המתווך לא העביר את הבקשה.
err-proxy-tip = כדאי לבדוק את השרת המתווך בהגדרות (רשת).
err-type-title = Ironswift לא יכול להציג את הקובץ הזה
err-type-detail = לא ניתן להציג סוג קובץ כזה בלשונית.
err-other-title = לא ניתן לטעון את הדף
err-other-detail = משהו השתבש בטעינת { $host }.
err-other-tip = כדאי לנסות שוב עם ↻.

## הגדרות
set-language = שפה
set-language-auto = כמו בשולחן העבודה
set-language-hint = לתפריטים ולהודעות של Ironswift, ולשפה שמדווחת לאתרים. נכנס לתוקף מלא בהפעלה הבאה של Ironswift.
set-high-contrast = ניגודיות גבוהה
set-high-contrast-hint = מציג דפים ואת הדפדפן בשחור, לבן וצהוב, ללא תמונות רקע, לקריאה קלה יותר.

## Screen readers (window, tabs, toolbar) and the settings page
a11y-tabs = לשוניות
a11y-toolbar = ניווט
a11y-address = שורת כתובת וחיפוש
tab-untitled = לשונית חדשה
button-back = אחורה
button-forward = קדימה
button-reload = טעינה מחדש
settings-title = הגדרות
settings-sub = נשמרות במחשב הזה בלבד.
settings-saved = ההגדרות נשמרו.
settings-cache-cleared = קובצי המטמון נמחקו (שוחררו { $mb } MB).
settings-startup = הפעלה וחיפוש
settings-home = דף הבית
settings-search-engine = מנוע חיפוש
settings-restore-tabs = פתיחה מחדש של הלשוניות מהפעם הקודמת
settings-bookmarks-bar = הצגת סרגל הסימניות
settings-memory = זיכרון
settings-sleep = השהיית לשוניות ברקע אחרי (דקות, 0 = אף פעם)
settings-sleep-hint = לשונית מושהית משחררת את הדף שלה ונטענת מחדש כשחוזרים אליה.
settings-gpu = ציור באמצעות כרטיס המסך
settings-gpu-hint = גלילה חלקה יותר ופחות עבודה למעבד; מנהל ההתקן הגרפי משתמש בכ־40–70 MB זיכרון נוספים. ייכנס לתוקף בהפעלה הבאה של Ironswift.
settings-privacy = פרטיות
settings-tpc = שיתוף עוגיות עם אתרים מוטמעים
settings-tpc-hint = כבוי כברירת מחדל: אתר המוטמע באתרים אחרים (רשת פרסום או מעקב, נגן וידאו) מקבל מאגר עוגיות נפרד בכל אתר, כך שאינו יכול לעקוב אחריך.
settings-strip = הסרת תגי מעקב מקישורים
settings-strip-hint = utm_source,‏ fbclid,‏ gclid ודומיהם.
settings-gpc = שליחת Global Privacy Control
settings-gpc-hint = מבקש מאתרים לא למכור או לשתף את המידע שלך.
settings-clear-exit = מחיקת עוגיות ונתוני אתרים בסגירת Ironswift
settings-clear-exit-hint = מנתק אותך מאתרים בכל פעם; ההיסטוריה והסימניות נשמרות.
settings-cookies-allow = לאפשר תמיד עוגיות מהאתרים האלה
settings-cookies-allow-hint = גם כשהם מוטמעים באתרים אחרים (לתיבות כניסה או תגובות שזקוקות להן).
settings-cookies-block = לא לאפשר אף פעם עוגיות מהאתרים האלה
settings-cookies-session = מחיקת העוגיות של האתרים האלה בסגירת Ironswift
settings-partition-hint = אתרים אחרים המוטמעים בדף מקבלים מאגר עוגיות משלהם לאותו דף, כך שאינם יכולים לעקוב אחריך מאתר לאתר.
settings-cookie-sites = אתרים עם עוגיות ({ $count })
settings-clear-data = ניקוי נתוני הגלישה עכשיו
settings-clear-data-hint = היסטוריה, עוגיות, נתוני אתרים וקובצי מטמון. הסימניות וההגדרות נשארות.
settings-private-hint = לגלישה שאינה שומרת דבר, יש לפתוח חלון פרטי עם Ctrl+Shift+N.
settings-blocking = חסימה ובטיחות
settings-block-ads = חסימת פרסומות
settings-block-ads-hint = EasyList: בקשות פרסום נעצרות ומקומות ריקים מוסתרים. הדפים נטענים מהר יותר.
settings-block-trackers = חסימת רכיבי מעקב
settings-block-trackers-hint = EasyPrivacy: כלי ניתוח, פיקסלי מעקב וסקריפטים של טביעת אצבע.
settings-no-blocking = ביטול החסימה באתרים האלה
settings-safe = אזהרה לפני אתרים מסוכנים
settings-safe-hint = אתרים ברשימת הנוזקות URLhaus וברשימת Phishing Army. הבדיקה נעשית במחשב הזה; שום דבר לא נשלח.
settings-rfp = הגנה מפני טביעת אצבע
settings-rfp-hint = אתרים רואים גודל מסך נפוץ, את הגופנים הרגילים וקריאות canvas משתנות מעט, כך שאינם יכולים לזהות את המחשב שלך לפי פרטיו.
settings-update-lists = עדכון הרשימות עכשיו
settings-permissions-hint = מצלמה, מיקרופון, מיקום והתראות: אתרים שואלים קודם.
settings-updates = עדכונים
settings-check-updates = בדיקת גרסאות חדשות פעם ביום
settings-check-now = בדיקה עכשיו
settings-appearance = מראה
settings-min-font = גודל גופן מזערי (פיקסלים, 0 = ללא)
settings-min-font-hint = מגדיל אותיות קטנות בדפים. Ctrl + ו־Ctrl − מגדילים אתר שלם.
settings-reduce-motion = הפחתת תנועה
settings-reduce-motion-hint = מבקש מאתרים לצמצם אנימציות למינימום.
settings-default-browser = דפדפן ברירת מחדל
settings-make-default = הגדרת Ironswift כדפדפן ברירת המחדל שלי
settings-network = רשת
settings-proxy = מתווך (Proxy)
settings-proxy-system = הגדרות המערכת
settings-proxy-none = ללא מתווך
settings-proxy-manual = שימוש במתווך הזה
settings-proxy-address = כתובת המתווך (עבור „שימוש במתווך הזה”)
settings-proxy-hint = „הגדרות המערכת” עוקב אחר המתווך של שולחן העבודה ואחר המשתנים http_proxy / https_proxy / no_proxy. אתרים מאובטחים נבדקים מול מאגר האישורים של המחשב.
settings-clear-cache = מחיקת קובצי המטמון
settings-cache-size = (‏{ $mb } MB שמורים כדי שדפים ייטענו מהר יותר)
settings-save = שמירת ההגדרות
settings-history = היסטוריה
settings-bookmarks = סימניות
settings-cookies-deleted = העוגיות של { $site } נמחקו.
settings-cookies-allowed = ‏{ $site } רשאי תמיד להשתמש בעוגיות.
settings-cookies-blocked = ‏{ $site } אינו יכול עוד להשתמש בעוגיות (העוגיות שלו נמחקו).
settings-cookies-session-set = העוגיות של { $site } יימחקו בסגירת Ironswift.
settings-cookies-default = ‏{ $site } כפוף לכללי העוגיות הרגילים.
settings-permissions-reset = ההרשאות של { $site } אופסו.
