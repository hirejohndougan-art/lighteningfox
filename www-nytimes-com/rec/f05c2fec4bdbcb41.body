  query ProgrammingHomeQuery(
    $rootNodeUrl: String!
    $menuEditionScoopSlug: String
    $targetingArguments: TargetingArguments
    $fdrPackageUri: String!
  )
  @cacheHint(
    includeSurrogateTypes: [
      "nyt://article/"
      "nyt://audio/"
      "nyt://carddeck/"
      "nyt://embeddedinteractive/"
      "nyt://interactive/"
      "nyt://legacycollection/"
      "nyt://programmingnode/"
      "nyt://programmingvariantset/"
      "nyt://promo/"
      "nyt://slideshow/"
      "nyt://video/"
    ]
  ) {
    home(id: $rootNodeUrl, targeting: $targetingArguments) {
      ...ProgrammingNodeProps
    }
    fdrPackage: home(id: $fdrPackageUri) {
      ...PackageNode
    }
    # Query to load data for the subnavigation menu on the server.
    subNavMenuData: scoopNodes(
      first: 1
      filter: { slug: $menuEditionScoopSlug, types: [ScoopSubNavMenu] }
    ) {
      edges {
        node {
          ... on ScoopSubNavMenu {
            ...SubNavMenuProps
          }
        }
      }
    }
  }
  ${qe}
  ${hS}
