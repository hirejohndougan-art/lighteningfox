  query HomeNativeActionsData($id: String!) {
    currentUser {
      subscriber {
        subscriptions {
          products
        }
      }
    }
    anyWork(id: $id) {
      ... on Article {
        __typename
        communityCommentsSummary {
          commentsEnabled
          totalCount
        }
        featuredAudio {
          asset {
            id
            __typename
            uri
            fileUrl
            sourceId
            length
            audioContentType
            headline {
              default
            }
            promotionalImage {
              image {
                id
                crops(renditionNames: ["square640", "threeByTwoLargeAt2X"]) {
                  name
                  renditions {
                    name
                    url
                    width
                  }
                }
              }
            }
            podcastSeries {
              title
              image {
                id
                crops(renditionNames: ["square640"]) {
                  name
                  renditions {
                    name
                    url
                    width
                  }
                }
              }
            }
          }
        }
      }
      ... on Interactive {
        __typename
        communityCommentsSummary {
          commentsEnabled
          totalCount
        }
      }
      ... on CreativeWork {
        summary
        kicker
      }
    }
  }
