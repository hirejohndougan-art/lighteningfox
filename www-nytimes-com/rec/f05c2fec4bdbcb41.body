  fragment OnEmbeddedInteractive on EmbeddedInteractive {
    id
    html
    credit @stripHtml
    slug
    compatibility
    storyFormat
    sourceId
    uri
    displayProperties {
      displayOverrides
    }
    promotionalMedia {
      ...OnImage
      __typename
    }
  }

  fragment OnVideo on Video {
    id
    isCinemagraph
    credits {
      role
      creator {
        ... on Person {
          id
          displayName
        }
      }
    }
    ... on CreativeWork {
      bylines {
        renderedRepresentation
      }
    }
    renditions {
      width
      height
      url
      type
      aspectRatio
    }
    headline {
      default
      __typename
    }
    embedded
    summary
    videoAssetSummary: summary
    promotionalHeadline
    promotionalSummary
    promotionalMedia {
      ...OnImage
      ... on Video {
        id
        uri
        autoplay
        isCinemagraph
        renditions {
          height
          url
          type
          aspectRatio
        }
      }
      __typename
    }
    url
    uri
    isLive
    liveUrls
    autoplay
    duration
    aspectRatio
  }

  fragment OnImage on Image {
    uri
    credit @stripHtml
    id
    sourceId
    uri
    summary
    altText
    caption {
      text @stripHtml
    }
    captionOverride {
      text @stripHtml
    }
    hideCaption
    timesTags {
      vernacular
    }
    crops(
      cropNames: [MEDIUM_SQUARE, SMALL_SQUARE, THREE_BY_TWO, TWO_BY_THREE, SIXTEEN_BY_NINE]
      renditionNames: [
        "threeByTwoSmallAt2X"
        "threeByTwoMediumAt2X"
        "smallSquare252"
        "square640"
        "mediumSquareAt3X"
        "verticalTwoByThree735"
        "smallTwoByThree"
        "videoSixteenByNine500"
        "videoSixteenByNineJumbo1600"
      ]
    ) {
      name
      renditions {
        width
        url
        name
        height
      }
    }
  }

  fragment Bylines on CreativeWork {
    bylines {
      renderedRepresentation
      creators {
        __typename
        ... on Person {
          id
          displayName
          promotionalMedia {
            __typename
            ... on Image {
              id
              crops(renditionNames: ["thumbLarge"]) {
                name
                renditions {
                  width
                  url
                  name
                  height
                }
              }
            }
          }
        }
      }
    }
  }

  fragment MediaProps on HasPromotionalProperties {
    __typename
    promotionalImage {
      image {
        id
        crops(
          cropNames: [THREE_BY_TWO, MEDIUM_SQUARE, SMALL_SQUARE]
          renditionNames: ["square640", "threeByTwoLargeAt2X", "smallSquare252", "smallSquare168"]
        ) {
          name
          renditions {
            name
            url
            width
          }
        }
      }
    }
    ... on CreativeWork {
      section {
        id
        displayName
      }
      advertisingProperties {
        sensitivity
      }
    }

    ... on Audio {
      id
      length
      fileUrl
    }
    ... on Recipe {
      url
    }
    ... on Slideshow {
      id
      slides {
        caption {
          text
        }
        image {
          id
          ...OnImage
        }
      }
      promotionalMedia {
        ...OnImage
        __typename
      }
    }
    ...OnImage
    ...OnVideo
    ...OnEmbeddedInteractive
    ... on CreativeWork {
      tone
    }
    ... on Published {
      uri
      sourceId
      lastModified
      firstPublished
    }
    ... on Linkable {
      __typename
      url
      id
      ... on Promo {
        targetUrl
        targetPublished {
          __typename
          uri
          ... on Recipe {
            totalTimeDisplay
          }
        }
      }
    }
    ... on Article {
      id
      headline {
        default
      }
      summary
      body {
        content {
          ... on HeaderMultimediaBlock {
            __typename
            media {
              __typename
              ...AudioBlockData
            }
          }
          ...AudioBlockData
        }
      }
      associatedNewsletter {
        newsletterProduct {
          id
          name
        }
      }
      promotions {
        name
        promotionalProperties {
          media {
            ... on Video {
              __typename
              uri
              sourceId
              url
              duration
              renditions {
                width
                height
                url
                type
                aspectRatio
              }
              promotionalMedia {
                ...OnImage
                __typename
              }
            }
          }
        }
      }
      featuredAudio {
        asset {
          id
          __typename
          audioContentType
          length
          uri
          fileUrl
          sourceId
          headline {
            default
          }
        }
      }
      wordCount
      ...Bylines
    }
    ... on Interactive {
      id
      __typename
      ... on CreativeWork {
        interactiveWordCount: wordCount
      }
      ...Bylines
    }
    ... on LegacyCollection {
      __typename
      name
      id
      sourceId
      unstructuredData: mobileHeader
      active
      lastModified
      url
      uri
      eventId
      assets(first: 10) {
        edges {
          node {
            ... on Article {
              __typename
              id
              sourceId
              url
              uri
              lastModified
              firstPublished
              typeOfMaterials
              headline {
                default
                sentence
              }
            }
          }
        }
      }
      groupings {
        containers {
          label
          name
          relations {
            asset {
              __typename
              ... on Article {
                __typename
                id
                sourceId
                url
                uri
                lastModified
                firstPublished
                typeOfMaterials
                headline {
                  default
                  sentence
                }
              }
            }
          }
        }
      }
    }
