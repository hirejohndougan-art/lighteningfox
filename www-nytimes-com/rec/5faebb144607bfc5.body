 * Document-level CSS for nyt-video-feed transitions.
 *
 * Organization:
 *   1. Visibility rules — apply to every feed regardless of mode.
 *   2. View-transition rules — only fire while a view transition is
 *      active (i.e. the horizontal-promo path; in-place never calls
 *      document.startViewTransition so these rules are inert there).
 */

/* ---------- 1. Visibility rules (all modes) ---------- */

body:has(nyt-video-feed.expanded-feed:not(.in-place)) {
  background: #000;
}

body:has(nyt-video-feed.expanded-feed:not(.in-place)) #site-content {
  visibility: hidden;
}

body:has(nyt-video-feed.expanded-feed:not(.in-place))
  nyt-video-feed.expanded-feed {
  visibility: visible;
}

/* ---------- 2. View-transition rules (horizontal-promo only) ---------- */

@keyframes fade-element {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes slide-down {
  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(0, 100vh, 0);
  }
}

html:active-view-transition-type(expand-player) {
  &::view-transition-new(root),
  &::view-transition-old(container),
  &::view-transition-old(.fade) {
    display: none;
  }

  &::view-transition-old(root) {
    animation: none;
  }

  ::part(overlay-play-controls) {
    view-transition-class: fade;
    view-transition-name: var(--view-transition-controls-name);
  }

  nyt-video-feed::part(navigation-controls) {
    view-transition-name: var(--view-transition-name-navigation-controls);
    view-transition-class: fade;
  }

  nyt-video-feed::part(player) {
    view-transition-name: var(--view-transition-name);
    view-transition-class: player;
  }

  nyt-video-feed::part(close-button),
  nyt-video-feed::part(scrubber) {
    view-transition-class: fade;
  }

  nyt-video-feed::part(close-button) {
    view-transition-name: var(--view-transition-name-close-button);
    view-transition-class: fade;
  }

  nyt-video-feed::part(scrubber) {
    view-transition-name: var(--view-transition-name-scrubber);
    view-transition-class: fade;
  }

  nyt-video-feed::part(container) {
    view-transition-name: var(--view-transition-name-container);
  }

  &::view-transition-old(.player) {
    opacity: 0;
  }

  &::view-transition-new(.player) {
    opacity: 1;
    animation: none;
  }

  --animation-duration: 500ms;
  --animation-easing: cubic-bezier(0.5, 0, 0.1, 1);

  &::view-transition-group(.player) {
    animation-duration: var(--animation-duration);
    animation-fill-mode: forwards;
    animation-timing-function: var(--animation-easing);
    overflow: hidden;
    z-index: 3;
  }

  &::view-transition-image-pair(.player) {
    display: flex;
  }

  &::view-transition-new(.player) {
    position: static;
    align-self: center;
  }

  &::view-transition-group(container) {
    animation-name: fade-element;
    animation-fill-mode: forwards;
    animation-duration: calc(var(--animation-duration) / 2);
    z-index: 2;
    width: 100%;
  }

  &::view-transition-group(.fade) {
    animation-name: fade-element;
    animation-duration: 200ms;
    animation-delay: 500ms;
    opacity: 0;
    z-index: 5;
  }
}

html:active-view-transition-type(slide-down) {
  --animation-easing: ease-out;

  nyt-video-feed::part(player) {
    view-transition-name: var(--view-transition-name);
    view-transition-class: player;
  }
  nyt-video-feed::part(expanded-player) {
    view-transition-name: var(--view-transition-name-collapsing-player);
  }

  nyt-video-feed::part(container) {
    view-transition-name: var(--view-transition-name-container);
  }

  &::view-transition-group(root) {
    animation: none;
  }

  &::view-transition-group(container) {
    animation: none;
    width: 100%;
    height: 100%;

    position: absolute;
    transform: none;
    z-index: 2;
  }

  &::view-transition-old(container) {
    animation-name: fade-element;
    animation-duration: 400ms;
    animation-direction: reverse;
    animation-fill-mode: forwards;
    animation-timing-function: var(--animation-easing);
    block-size: auto;
    inline-size: auto;
    inset-block-start: auto;
    position: static;
    width: 100%;
  }

  &::view-transition-new(container),
  &::view-transition-old(root) {
    display: none;
  }

  &::view-transition-old(collapsing-player) {
    animation-name: slide-down;
    animation-duration: 400ms;
    animation-timing-function: var(--animation-easing);
    animation-fill-mode: forwards;
  }

  &::view-transition-group(.player) {
    animation: none;
  }

  &::view-transition-group(collapsing-player) {
    animation: none;
    z-index: 3;
  }
}
