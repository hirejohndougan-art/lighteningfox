  fragment AssetHelmet_promotionalImage on HasPromotionalProperties {
    promotionalImage {
      socialMediaRendition: signableRendition(
        renditionPriority: ["facebookJumbo", "videoSixteenByNineJumbo1600", "articleLarge"]
      ) {
        ...AssetHelmet_signableRendition
      }
      twitterRendition: signableRendition(
        renditionPriority: ["videoSixteenByNine3000", "videoSixteenByNineJumbo1600", "articleLarge"]
      ) {
        ...AssetHelmet_signableRendition
      }
      image {
        id
        credit
        caption {
          text
        }
      }
    }
  }

  fragment AssetHelmet_signableRendition on SignableImageRendition {
    parentPublishDate
    parentPublishYear
    signature {
      value
      keyId
      __typename
    }
    rendition {
      name
      height
      width
      url
      __typename
    }
    __typename
  }
`;_.fragments={asset:r`
    fragment AssetHelmet_asset on HasPromotionalProperties {
      ... on Linkable {
        id
        url
      }
      ... on Article {
        id
        translations {
          language {
            code
          }
        }
        language {
          code
          name
        }
        rights {
          category
        }
      }
      ... on Audio {
        id
        translations {
          language {
            code
          }
        }
        language {
          code
          name
        }
      }
      ... on Video {
        id
        language {
          code
          name
        }
      }
      ... on Interactive {
        id
        translations {
          language {
            code
          }
        }
        language {
          code
          name
        }
        rights {
          category
        }
      }
      ... on Slideshow {
        id
        translations {
          language {
            code
          }
        }
        language {
          code
          name
        }
      }
      ... on CreativeWork {
        collections @filterEmpty {
          id
          slug
          collectionType
        }
        headline {
          default @stripHtml
          seo @stripHtml
        }
        summary
        timesTags @filterEmpty {
          displayName
          vernacular
        }
        section {
          id
          displayName
          name
        }
        subsection {
          id
          name
        }
        bylines {
          renderedRepresentation
          creators {
            ... on Published {
              url
            }
          }
        }
      }
      ... on Published {
        firstPublished
        lastModified
        lastMajorModification
        sourceId
        uri
        eventId
      }
      promotionalMedia {
        ...AssetHelmet_promoImage
        ... on EmbeddedInteractive {
          id
          promotionalMedia {
            ...AssetHelmet_promoImage
          }
        }
        ... on Video {
          id
          promotionalMedia {
            ...AssetHelmet_promoImage
            ... on Video {
              id
              promotionalMedia {
                ...AssetHelmet_promoImage
              }
            }
          }
        }
        ... on Audio {
          id
          promotionalMedia {
            ...AssetHelmet_promoImage
          }
        }
      }
      ...AssetHelmet_promotionalImage
    }
    ${v}
    ${r`
  fragment AssetHelmet_promoImage on Image {
    id
    assetCrops: crops(
      renditionNames: [
        "thumbStandard"
        "thumbLarge"
        "facebookJumbo"
        "videoSixteenByNine3000"
        "videoSixteenByNineJumbo1600"
        "googleFourByThree"
        "articleLarge"
        "superJumbo"
        "mediumSquareAt3X"
      ]
    ) {
      name
      renditions {
        url
        height
        width
        name
      }
    }
    credit
    caption {
      text
    }
  }
`}
