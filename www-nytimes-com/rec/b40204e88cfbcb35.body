  fragment SummaryFragment on CommunityCommentsSummary {
    id
    totalCount
  }
`,pe=r`
 query communityCommentsSummaryQuery(
    $uri: String!
    $input: CommunityCommentPagingInput!
  ) {
    communityComments(uri:$uri, input: $input) {
      summary {
        id
        assetID
        anyWork {
          ...on Article {
            headline {
              default
            }
          }
          ...on Interactive {
            headline {
              default
            }
          }
          ...on LegacyCollection {
            headline {
              default
            }
          }
          ...on Video {
            headline {
              default
            }
          }
        }
        commentsOpen
        defaultView
        prompt
        totalReadersPicks
        totalReporterReplies
        totalTimesPicks
        uri
        ...SummaryFragment
      }
    }
  }
  ${J}
