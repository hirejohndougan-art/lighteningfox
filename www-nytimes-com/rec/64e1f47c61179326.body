  query endSlateQuery($id: String!) {
    anyWork(id: $id) @filterEmpty {
      __typename
      ... on CardDeck {
        id
        asset {
          ... on WatchTab {
            cards {
              assets {
                ... on Video {
                  id
                  sourceId
                  promotionalMedia {
                    ... on Image {
                      id
                      crops(renditionNames: ["smallTwoByThree", "jumbo"]) {
                        name
                        renditions {
                          name
                          url
                          width
                          height
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
