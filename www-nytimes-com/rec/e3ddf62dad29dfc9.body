14-2026-11-03","PA-G-H-14-2026-11-03","TX-G-H-15-2026-11-03","PA-G-H-15-2026-11-03","TX-G-H-16-2026-11-03","PA-G-H-16-2026-11-03","TX-G-H-17-2026-11-03","PA-G-H-17-2026-11-03","RI-G-S-2026-11-03","SC-G-S-2026-11-03","SD-G-S-2026-11-03","TN-G-S-2026-11-03","WY-G-H-1-2026-11-03","WV-G-H-1-2026-11-03","WI-G-H-1-2026-11-03","WA-G-H-1-2026-11-03","VT-G-H-1-2026-11-03","VA-G-H-1-2026-11-03","UT-G-H-1-2026-11-03","US-G-H-2026-11-03","WV-G-H-2-2026-11-03","WI-G-H-2-2026-11-03","WA-G-H-2-2026-11-03","VA-G-H-2-2026-11-03","UT-G-H-2-2026-11-03","WI-G-H-3-2026-11-03","WA-G-H-3-2026-11-03","VA-G-H-3-2026-11-03","UT-G-H-3-2026-11-03","TX-G-H-3-2026-11-03","WI-G-H-4-2026-11-03","WA-G-H-4-2026-11-03","VA-G-H-4-2026-11-03","UT-G-H-4-2026-11-03","TX-G-H-4-2026-11-03","WI-G-H-5-2026-11-03","WA-G-H-5-2026-11-03","VA-G-H-5-2026-11-03","TX-G-H-5-2026-11-03","WI-G-H-6-2026-11-03","WA-G-H-6-2026-11-03","VA-G-H-6-2026-11-03","TX-G-H-6-2026-11-03","WI-G-H-7-2026-11-03","WA-G-H-7-2026-11-03","VA-G-H-7-2026-11-03","TX-G-H-7-2026-11-03","WI-G-H-8-2026-11-03","WA-G-H-8-2026-11-03","VA-G-H-8-2026-11-03","TX-G-H-8-2026-11-03","WA-G-H-9-2026-11-03","VA-G-H-9-2026-11-03","TX-G-H-9-2026-11-03","WA-G-H-10-2026-11-03","VA-G-H-10-2026-11-03","VA-G-H-11-2026-11-03","TX-G-H-18-2026-11-03","TX-G-H-19-2026-11-03","TX-G-H-20-2026-11-03","TX-G-H-21-2026-11-03","TX-G-H-22-2026-11-03","TX-G-H-23-2026-11-03","TX-G-H-24-2026-11-03","TX-G-H-25-2026-11-03","TX-G-H-26-2026-11-03","TX-G-H-27-2026-11-03","TX-G-H-28-2026-11-03","TX-G-H-29-2026-11-03","TX-G-H-30-2026-11-03","TX-G-H-31-2026-11-03","TX-G-H-32-2026-11-03","TX-G-H-33-2026-11-03","TX-G-H-34-2026-11-03","TX-G-H-35-2026-11-03","TX-G-H-36-2026-11-03","TX-G-H-37-2026-11-03","TX-G-H-38-2026-11-03","TX-G-S-2026-11-03","VA-G-S-2026-11-03","WV-G-S-2026-11-03","WY-G-S-2026-11-03"],"close_races":["AK-G-S-2026-11-03","MS-G-S-2026-11-03","CO-G-H-4-2026-11-03"],"hp_key_races":["GA-G-G-2026-11-03","FL-G-G-2026-11-03","AK-G-G-2026-11-03","KS-G-G-2026-11-03","NV-G-G-2026-11-03","OH-G-G-2026-11-03","TX-G-G-2026-11-03"],"hp_key_races_mobile":["FL-G-G-2026-11-03","GA-G-G-2026-11-03","AK-G-G-2026-11-03","KS-G-G-2026-11-03","NV-G-G-2026-11-03","TX-G-G-2026-11-03","OH-G-G-2026-11-03"],"hp_senate_races_to_watch":["ME-G-S-2026-11-03","TX-G-S-2026-11-03","OH-S_W-S-2026-11-03","MI-G-S-2026-11-03","SC-G-S-2026-11-03","MN-G-S-2026-11-03","KS-G-S-2026-11-03","IA-G-S-2026-11-03","AK-G-S-2026-11-03","MS-G-S-2026-11-03","NC-G-S-2026-11-03","NH-G-S-2026-11-03"],"hp_senate_races_to_watch_mobile":["MI-G-S-2026-11-03","OH-S_W-S-2026-11-03","ME-G-S-2026-11-03","TX-G-S-2026-11-03","SC-G-S-2026-11-03","IA-G-S-2026-11-03","AK-G-S-2026-11-03","MS-G-S-2026-11-03"]},"navigation":[],"documents":[{"name":"2026-11-03 Live Activity Text","contents":{"text":[{"paragraph":"2026 Senate results","placement":{"id":"live_activity_title_text"}},{"paragraph":"Senate results","placement":{"id":"live_activity_short_title_text"}},{"paragraph":"34 seats not up for election","placement":{"id":"live_activity_dem_seats_not_up"}},{"paragraph":"31 seats not up for election","placement":{"id":"live_activity_rep_seats_not_up"}},{"paragraph":"Tap here to see the latest results","placement":{"id":"live_activity_stale_message"}},{"paragraph":"Follow the latest results","placement":{"id":"live_activity_introduction_message"}},{"paragraph":"Results are paused due to a technical issue. They will resume shortly.","placement":{"id":"live_activity_fallback_message"}}]},"updated_at":"2026-10-29T20:47:49.763086+00:00"},{"name":"2026-11-03 Model Related","contents":{"text":[{"paragraph":"Our election model estimates which party will win the Senate and House in real time based on polling data, the votes reported so far and what we expect from remaining votes. <a href=\"https://www.nytimes.com/live/2026/us/times-election-results-explained/how-does-the-needle-work\">Read how it works ›</a>","placement":{"id":"model-overview-intro"}},{"hed":"A chance of no clear Senate control","paragraph":"There is a chance that <a href=\"https://www.nytimes.com/2026/11/02/us/politics/senate-midterms-tie-independents-wild-cards.html\">neither party</a> will win enough seats to claim control of the Senate.","placement":{"id":"no-control-header"}},{"placement":{"type":"needle-header-H"},"paragraphs":[{"hed":"House forecast in detail","paragraph":"These are our estimates for which party will win control of the House and the national popular vote, and the estimated number of seats each party could win. Our model’s estimates are based on polling and historical results, the votes reported so far, and the votes we think remain."}]},{"placement":{"type":"needle-header-S"},"paragraphs":[{"hed":"Senate forecast in detail","paragraph":"These are our estimates for which party will win control of the Senate, and the estimated number of seats each party could win. Our model’s estimates are based on polling and historical results, the votes reported so far, and the votes we think remain."}]},{"paragraph":"Waiting for estimates","placement":{"id":"model-key-races-placeholder"}},{"paragraph":"Waiting for estimates","placement":{"type":"model-inactive-waiting-for-results-short"}},{"paragraph":"Estimates paused","placement":{"type":"model-inactive-paused-short"}},{"paragraph":"We have temporarily paused our estimates.","placement":{"type":"model-inactive-paused-long"}},{"paragraph":"We turned off the live forecast at 3 a.m. Eastern on Nov. 4. These graphics and estimates will no longer be updated.","placement":{"type":"model-shutoff-text"}},{"paragraph":"We stopped updating the live forecast at 3 a.m. Eastern on Nov. 4. This map will no longer be updated.","placement":{"type":"map-model-shutoff-text"}},{"placement":{"id":"S","type":"model-timeseries-intro"}},{"placement":{"type":"race-model-intro"},"paragraphs":[{"hed":"Live forecast","paragraph":"Our election model estimates who will win in real time based on pre-election data, reported votes, and the votes we think remain. As more votes are counted, it becomes more certain."}]},{"placement":{"type":"race-model-intro-rcv"},"paragraphs":[{"hed":"Live forecast","paragraph":""}]},{"placement":{"type":"model-blend-descriptions"},"paragraphs":[{"hed":"","paragraph":"At the start of the night, our estimate is based on pre-election polls, past election results and demographic data."},{"hed":"","paragraph":"As votes come in, we compare actual results to our pre-election estimates to create a statistical model of the remaining vote."},{"hed":"","paragraph":"As a county reports more votes, these tabulated results will gradually supersede our previous estimates."}]},{"placement":{"type":"no-control-senate-needles"},"paragraphs":[{"hed":"A chance of no clear Senate control","paragraph":"Our model estimates that there is a chance that neither party wins outright control in the Senate. <a href=#overview-top-needle-house>Jump to our House forecast ›</a>"}]}]},"updated_at":"2026-11-05T20:23:01.909104+00:00"},{"name":"2026-11-03 Race Blurbs","contents":{"text":[]},"updated_at":"2026-10-29T15:11:46.756566+00:00"},{"name":"2026-11-03 Vote Reporting Expectations","contents":{"text":[{"paragraph":"First results from the state usually come in around 10 p.m. Eastern time. Most voters cast ballots by mail, and full, unofficial counting typically takes days.","placement":{"type":"expectations-text","state":"AZ"}},{"paragraph":"Most voters tend to vote early in person, and vote reporting is usually relatively fast. But if a race is very close, it can still take awhile to declare a winner. In 2022, it took until Wednesday afternoon for The A.P. to declare that the top Senate candidates had advanced to a runoff, which was held on Dec. 6.","placement":{"type":"expectations-text","state":"GA"}},{"paragraph":"In 2022 and 2024, about half of the state’s votes were reported by midnight Eastern time on election night, and the count reached 95 percent around 6 a.m. on Wednesday.","placement":{"type":"expectations-text","state":"MI"}},{"paragraph":"In 2024, just under half of voters cast ballots by mail, and it took about two days to report 95 percent of votes statewide. Postmarked ballots must arrive by the fourth day after the election, Nov. 7.","placement":{"type":"expectations-text","state":"NV"}},{"paragraph":"In 2024, 95 percent of the state’s votes were reported just after midnight on election night. Procedural changes could make that even faster this year.","placement":{"type":"expectations-text","state":"NC"}},{"paragraph":"In the past two general elections, 97 percent of the state’s votes were counted by noon Eastern time the day after the election. Counting has sped up since 2020, when it took several days to finish counting mail ballots.","placement":{"type":"expectations-text","state":"PA"}},{"paragraph":"In 2024, 95 percent of the state’s votes were reported by 5 a.m. Eastern time the morning after the election. In some places, absentee ballots are counted at a central facility and reported in large batches.","placement":{"type":"expectations-text","state":"WI"}},{"paragraph":"Most results are typically reported by 1 a.m. Eastern time, and congressional races in recent general elections have been called by The Associated Press on election night.","placement":{"type":"expectations-text","state":"AL"}},{"paragraph":"First results are expected around 1 a.m. Eastern time. In 2024, about 75 percent of votes were reported on election night, and the remaining votes were reported between seven and fifteen days later. Ranked-choice voting is used in federal and state races; if no candidate receives more than 50 percent of the vote, the next tabulation will be conducted on Nov. 18.","placement":{"type":"expectations-text","state":"AK"}},{"paragraph":"Most results are typically reported by early Wednesday morning, and recent congressional races have all been called by The A.P. on election night.","placement":{"type":"expectations-text","state":"AR"}},{"paragraph":"Most voters cast votes by mail, and ballots can take days — or even weeks — to count. Counties have until the 13th day after the election to report their votes, with some exceptions. During the state’s June primaries, this slow process fostered suspicion when<a href=\"https://www.nytimes.com/2026/06/17/upshot/california-slow-election-results.html\"> </a><a href=\"https://www.nytimes.com/2026/06/17/upshot/california-slow-election-results.html\">two candidates flipped positions five days into vote counting</a> — a phenomenon that is common with election results but usually happens quickly on election night.","placement":{"type":"expectations-text","state":"CA"}},{"paragraph":"The state has long conducted its elections by mail. In 2022 and in 2024, it took about four days to report 95 percent of votes in statewide races. If a race is close, it could take awhile for The A.P. to call a winner.","placement":{"type":"expectations-text","state":"CO"}},{"paragraph":"In 2024, it took a day and a half before 95 percent of votes were counted. But because the state’s congressional races were not especially competitive, they were all called by The A.P. on election night or in the early morning after.","placement":{"type":"expectations-text","state":"CT"}},{"paragraph":"Votes are reported fast, with nearly all ballots counted before midnight in recent elections.","placement":{"type":"expectations-text","state":"DE"}},{"paragraph":"In 2024, about 87 percent of votes were reported by noon Wednesday. The district recently implemented ranked-choice voting, so if no candidate wins more than 50 percent of the vote in certain races, it could take days before additional tabulations are released.","placement":{"type":"expectations-text","state":"DC"}},{"paragraph":"Votes are counted very quickly, with 99 percent of votes reported by midnight in recent general elections. First votes are expected after most polls close at 7 p.m. Eastern time.","placement":{"type":"expectations-text","state":"FL"}},{"paragraph":"The state runs a predominantly mail election. In 2024, it took until about 4 p.m. Eastern time on Wednesday to reach 95 percent of votes. In 2022, it took an additional day.","placement":{"type":"expectations-text","state":"HI"}},{"paragraph":"First results from the state are expected after 11 p.m. Eastern time. In 2022 and 2024, most results were reported by Wednesday afternoon.","placement":{"type":"expectations-text","state":"ID"}},{"paragraph":"In 2024, nearly 95 percent of the state’s votes were reported by noon Eastern time on Wednesday. Ballots postmarked by Election Day have two weeks to arrive.","placement":{"type":"expectations-text","state":"IL"}},{"paragraph":"First results from the state are expected after most polls close at 6 p.m. Eastern time. In 2022 and 2024, most ballots were counted by noon Eastern time on Wednesday.","placement":{"type":"expectations-text","state":"IN"}},{"paragraph":"In 2024, 90 percent of the state’s votes were reported by midnight Eastern time, and 99 percent were in by noon Wednesday.<a href=\"https://www.nytimes.com/interactive/2024/11/05/us/elections/results-iowa-us-house-1.html\"> </a><a href=\"https://www.nytimes.com/interactive/2024/11/05/us/elections/results-iowa-us-house-1.html\">One extremely close House race</a> went to a recount and took weeks to decide.","placement":{"type":"expectations-text","state":"IA"}},{"paragraph":"Most votes were reported by noon Eastern time on Wednesday in 2022 and 2024. Mail ballots have three days to arrive if postmarked by Election Day, but only about one in 10 voters cast them.","placement":{"type":"expectations-text","state":"KS"}},{"paragraph":"First results from the state are expected after most polls close at 6 p.m. Eastern time. In 2024, nearly all votes were counted by midnight on election night.","placement":{"type":"expectations-text","state":"KY"}},{"paragraph":"Most votes are typically reported by midnight Eastern time on election night. Elections for the state’s six U.S. House seats will be open primaries; if no candidate receives a majority of the vote, the top two vote-getters will advance to a Dec. 12 election.","placement":{"type":"expectations-text","state":"LA"}},{"paragraph":"In 2024, it took about a day and a half to reach 95 percent of votes. Ranked choice will be used in the Senate and 2nd Congressional District races, and only first rankings will be available; if no candidate receives a majority, a second tabulation will occur in the days after the election. In 2024, the results of<a href=\"https://www.nytimes.com/interactive/2024/11/05/us/elections/results-maine-us-house-2.html\"> </a><a href=\"https://www.nytimes.com/interactive/2024/11/05/us/elections/results-maine-us-house-2.html\">a House race that required a second round</a> were released 10 days after the election.","placement":{"type":"expectations-text","state":"ME"}},{"paragraph":"In 2024, 80 percent of the state’s votes were reported by midnight on election night, and it took several days to reach 95 percent of votes. Ballots postmarked by Election Day have 10 days to arrive.","placement":{"type":"expectations-text","state":"MD"}},{"paragraph":"In 2024, about two-thirds of the state’s votes were reported by midnight on election night, but officials said a longer ballot this year could take more time to process. Ballots postmarked by Election Day have three days to arrive.","placement":{"type":"expectations-text","state":"MA"}},{"paragraph":"In 2024, 56 percent of the state’s votes were reported by midnight Eastern time on election night, and complete unofficial results were in by noon the next day. The deadline for hand-returning absentee ballots on Election Day is now 6 p.m. Eastern time instead of when the polls close.","placement":{"type":"expectations-text","state":"MN"}},{"paragraph":"In 2024, 84 percent of votes were reported by midnight Eastern time on election night. But because the state’s congressional races are not typically competitive, The A.P. tends to call them not long after polls close.","placement":{"type":"expectations-text","state":"MS"}},{"paragraph":"Most results are typically reported by early Wednesday morning, and recent congressional races have all been called by The A.P. on election night.","placement":{"type":"expectations-text","state":"MO"}},{"paragraph":"Most voters cast ballots by mail, which must be received by Election Day. In recent elections, it has taken a day or two to count 95 percent of the votes.","placement":{"type":"expectations-text","state":"MT"}},{"paragraph":"In 2024, about 60 percent of the state’s votes were reported by midnight Eastern time on election night, and 95 percent were in by 5 a.m.","placement":{"type":"expectations-text","state":"NE"}},{"paragraph":"Vote counting was faster in 2024 than in 2022, with three-quarters of the state’s votes reported by midnight on election night, and 93 percent reported by noon the next day.","placement":{"type":"expectations-text","state":"NH"}},{"paragraph":"In 2024, 91 percent of the state’s votes were reported by midnight on election night, and 96 percent were in by noon the next day.","placement":{"type":"expectations-text","state":"NJ"}},{"paragraph":"By 1 a.m. Eastern time, processing of absentee ballots must either conclude, or pause and resume the next day. In the last two general elections, nearly all unofficial results were reported by noon Eastern time the day after the election.","placement":{"type":"expectations-text","state":"NM"}},{"paragraph":"Most votes are expected by noon on Wednesday. Mail ballots have a week to arrive if postmarked by Election Day, but only about one in 10 voters cast them in 2024.","placement":{"type":"expectations-text","state":"NY"}},{"paragraph":"In recent general elections, nearly all unofficial results were reported by noon Eastern time on Wednesday.","placement":{"type":"expectations-text","state":"ND"}},{"paragraph":"In recent general elections, 95 percent of votes were reported by midnight Eastern time. Officials expect nearly all unofficial votes to be counted before they leave for the night, because absentee ballots are now due on Election Day instead of four days later (if postmarked). In 2024, it took more than two weeks for the A.P. to call a winner<a href=\"https://www.nytimes.com/interactive/2024/11/05/us/elections/results-ohio-us-house-9.html\"> </a><a href=\"https://www.nytimes.com/interactive/2024/11/05/us/elections/results-ohio-us-house-9.html\">in an extremely close race.</a>","placement":{"type":"expectations-text","state":"OH"}},{"paragraph":"In recent general elections, nearly all votes have been reported by midnight Eastern time on election night.","placement":{"type":"expectations-text","state":"OK"}},{"paragraph":"In recent elections, it has taken more than a week to reach 95 percent of votes counted. The state conducts all-mail elections, and ballots postmarked by Election Day have seven days to arrive.","placement":{"type":"expectations-text","state":"OR"}},{"paragraph":"Most votes are typically counted by around midnight Eastern time on election night.","placement":{"type":"expectations-text","state":"RI"}},{"paragraph":"Most votes are typically counted by midnight Eastern time on election night.","placement":{"type":"expectations-text","state":"SC"}},{"paragraph":"First results are expected after 9 p.m. Eastern time. More than one-third of voters cast ballots by mail in 2024, and 92 percent of votes were reported by noon Eastern time on Wednesday.","placement":{"type":"expectations-text","state":"SD"}},{"paragraph":"Most votes are typically counted by midnight Eastern time on election night.","placement":{"type":"expectations-text","state":"TN"}},{"paragraph":"In recent elections, 80 to 90 percent of the state’s votes were reported by midnight Eastern time, and 99 percent were in before 7 a.m. the day after the election. Voting by mail requires a valid excuse, and only a small share of voters cast ballots this way.","placement":{"type":"expectations-text","state":"TX"}},{"paragraph":"Most voters cast ballots by mail or dropbox, and it has typically taken more than a week to count 95 percent of votes. New rules requiring officials to verify the last four digits of voters' Social Security or driver's license numbers are expected to extend that timeline.","placement":{"type":"expectations-text","state":"UT"}},{"paragraph":"Nearly all votes are typically counted by noon Eastern time the day after the election.","placement":{"type":"expectations-text","state":"VT"}},{"paragraph":"In recent elections, the state reached 95 percent of votes reported on election night or in the early morning hours after.","placement":{"type":"expectations-text","state":"VA"}},{"paragraph":"In recent general elections, it has taken about eight days to report 95 percent of the state’s votes. Nearly all voters cast ballots by mail or drop box, and ballots with a postmark have 20 days to arrive.","placement":{"type":"expectations-text","state":"WA"}},{"paragraph":"In recent general elections, more than 95 percent of votes have been reported by midnight Eastern time.","placement":{"type":"expectations-text","state":"WV"}},{"paragraph":"In recent general elections, full unofficial results were reported by noon Eastern time on Wednesday.","placement":{"type":"expectations-text","state":"WY"}}]},"updated_at":"2026-11-01T16:54:39.420633+00:00"},{"name":"2026-11-03 Race Pages","contents":{"text":[{"paragraph":"Ranked-choice tabulation will occur on Nov. 18.","placement":{"type":"rcv-table-final-round-placeholder","state":"AK"}},{"paragraph":"Race to be decided by ranked-choice tabulation.","placement":{"type":"rcv-table-final-round-placeholder","state":"ME"}}]},"updated_at":"2026-11-02T20:00:22.526446+00:00"},{"name":"2026-11-03 National Pages","contents":{"text":[{"paragraph":"The FLIP_SEATS Newly Elected Democrats Who Flipped Seats, and Whom They Unseated","placement":{"id":"general-dashboard-hed"}},{"paragraph":"As the nation’s voters shifted toward Democrats, at least 38 incumbent governors and members of Congress, nearly all Republicans, were elected out of office.","placement":{"id":"general-dashboard-intro"}},{"paragraph":"Four incumbent losses (the tally as of Friday) is not unheard of — five incumbent senators lost re-election in the 2018 and 2020 general elections. Senator Susan Collins, a Republican representing Maine for nearly 30 years, was the longest-tenured senator since 2008 to lose a general election.","placement":{"id":"general-dashboard-senate"}},{"paragraph":"The last time two incumbent governors lost their re-election contests in the general election was in 2018, when Republicans in Illinois and Wisconsin were voted out.","placement":{"id":"general-dashboard-governor"}},{"paragraph":"Incumbent losses in the House are roughly on par with the 2018 general election, when 30 Republicans lost their seats. The modern record for incumbent losses was set in 2010, when 54 members were unseated in the general election.","placement":{"id":"general-dashboard-house"}},{"paragraph":"Note: This list includes Democrats who flipped a seat held by a Republican, including in states that redistricted where a current member of Congress was on the ballot in the House race. House races without an incumbent in states that redrew their congressional boundaries are not included. As of Nov. 6 at 5 p.m. Eastern, one Democratic incumbent has lost a seat in Congress. This list will update as more races are called. The Associated Press lists a candidate as an incumbent if they are seeking re-election to their current legislative body, even if they are running in a different district.","placement":{"id":"general-dashboard-note"}},{"paragraph":"Democrats have taken control of the Senate, securing victories in several states that President Trump won by double digits in 2024.","placement":{"id":"senate-intro"}},{"paragraph":"Our election model estimates the outcome of the race in real time based on polling data, the votes reported so far and what we expect from remaining votes.","placement":{"id":"senate-needle-promo-intro"}},{"paragraph":"Democrats have won their target number of competitive states and are on track to win the Senate.","placement":{"id":"senate-target-races-democrat__"}},{"paragraph":"Republicans have won their target number of competitive states and are on track to win the Senate.","placement":{"id":"senate-target-races-republican__"}},{"placement":{"id":"senate-tipping-point"},"paragraphs":[{"hed":"Tracking the key Senate races","paragraph":"These closely watched races played a key role in determining control of the U.S. Senate."}]},{"paragraph":"Democrats took control of the House early Wednesday and were on track to amass the largest majority since the 2008 election.","placement":{"id":"house-intro"}},{"paragraph":"Our election model estimates the outcome of the race in real time based on polling data, the votes reported so far and what we expect from remaining votes.","placement":{"id":"house-needle-promo-intro"}},{"paragraph":"Democrats have won their target number of competitive districts and are on track to win the House.","placement":{"id":"house-target-races-democrat__"}},{"paragraph":"Republicans have won their target number of competitive districts and are on track to win the House.","placement":{"id":"house-target-races-republican__"}},{"placement":{"id":"house-tipping-point"},"paragraphs":[{"hed":"Tracking the key House races","paragraph":"In order to maintain control of the House, Republicans needed to win most of the districts below, many of which were rated as leaning toward Democrats before the election."}]},{"paragraph":"Note: Possible gain from redistricting is the pre-election estimate of the change in seats made possible by the new congressional maps. <a href=\"https://www.nytimes.com/interactive/2026/us/politics/midterms-house-maps-redistricting.html\">Read&nbsp;more&nbsp;›</a>","placement":{"type":"house-seat-gains-by-state"}},{"paragraph":"As of Wednesday morning, <a href=\"https://www.nytimes.com/2026/11/04/us/democrats-governors.html\">Democrats took five new seats</a> for a total of 29, giving them a majority for the first time in years. The wins could expand state-level resistance to the Trump administration.","placement":{"id":"governor-intro"}},{"paragraph":"TK intro text on House remaining races page.","placement":{"id":"house-race-tracker-intro"}},{"hed":"","paragraph":"","placement":{"type":"house-race-tracker-note"},"timestamp":"2026-11-04 9:00 AM"},{"hed":"Social Policy","paragraph":"Voters in several states are weighing in on ballot measures on the right to abortion and the participation of transgender students in school sports.","placement":{"id":"social_policy_ballot_measures","type":"general-collection-page"}},{"hed":"Wealth","paragraph":"Several measures are on the ballot asking voters to weigh in on taxing the rich.","placement":{"id":"wealth_ballot_measures","type":"general-collection-page"}},{"hed":"Redistricting","paragraph":"After a mid-decade redistricting blitz ahead of this year’s elections, some states are asking voters to rethink how congressional maps are drawn.","placement":{"id":"redistricting_ballot_measures","type":"general-collection-page"}},{"hed":"Voting and Campaign Finance","paragraph":"Ballot measures across the country address voting and campaign finance issues, including ranked-choice voting, “dark money,” expanded voting rights and citizenship and voter ID requirements.","placement":{"id":"voter_id_ballot_measures","type":"general-collection-page"}},{"hed":"Others","paragraph":"","placement":{"id":"misc_ballot_measures","type":"general-collection-page"}}]},"updated_at":"2026-11-06T22:35:48.562186+00:00"},{"name":"2026-11-03 Race Call Overrides","contents":{"text":[{"hed":"Republicans Win the Senate","liveblog":"Republicans win control of the U.S. Senate.","paragraph":"Republicans will keep control of the chamber.","placement":{"id":"Senate-control","type":"race-call","party":"Republican"},"liveactivity":"Republicans win the Senate."},{"hed":"Democrats Win the Senate","liveblog":"Democrats win control of the U.S. Senate.","paragraph":"Democrats regain control of the chamber.","placement":{"id":"Senate-control","type":"race-call","party":"Democrat"},"liveactivity":"Democrats win the Senate."},{"hed":"Senate Control is Unclear","liveblog":"With all U.S. Senate seats called, control of the chamber is unclear.","paragraph":"Neither party has won enough seats to claim a majority.","placement":{"id":"Senate-control","type":"race-call","party":"Unclear"},"liveactivity":"No clear Senate majority."},{"hed":"Democrats Win the House","liveblog":"Democrats win the U.S. House.","paragraph":"Democrats regain control of the chamber.","placement":{"id":"House-control","type":"race-call","party":"Democrat"}},{"hed":"Republicans Hold Onto the House","liveblog":"Republicans win the U.S. House.","paragraph":"The G.O.P. will keep control of the House of Representatives.","placement":{"id":"House-control","type":"race-call","party":"Republican"}}]},"updated_at":"2026-10-27T16:38:47.679986+00:00"},{"name":"2026-11-03 Needle sentence","contents":{"8":"27pm</strong><strong>The Needle is back</strong>Our live forecast is estimating the outcome of the presidential race, based on pre-election data, the votes reported so far, and the votes we think remain. Almost all of the vote counted so far points toward a very close election.<strong>9</strong><strong>:17pm</strong><strong>The Needle’s early take</strong>Trump is now a narrow but clear favorite to win Georgia and North Carolina. If he does, Harris would probably need to sweep the three Northern swing states — a real possibility, but a tall order.<strong>10</strong><strong>:43pm</strong><strong>Harris’s path narrows</strong>Trump is very likely to take Georgia and North Carolina. To win, Harris will probably need to sweep Pennsylvania, Michigan and Wisconsin — but Trump has an advantage in all three.<strong>11</strong><strong>:19pm</strong><strong>Harris’s path narrows</strong>Trump has won in North Carolina and is very likely to take Georgia. To win, Harris will probably need to sweep Pennsylvania, Michigan and Wisconsin — but Trump has an advantage in all three.<strong>12</strong><strong>:50am</strong><strong>The U.S. shifts to the right</strong>In every state that has counted most of its votes, Trump has improved on his performance from 2020. And he is favored in each of Pennsylvania, Michigan and Wisconsin — states Harris almost certainly must win.<strong>2</strong><strong>:34am</strong><strong>The U.S. shifts to the right</strong>In every state that has counted most of its votes, Trump has improved on his performance from 2020. He has flipped Georgia and Pennsylvania and needs only one more state to win.","text":[{"paragraph":"Live forecast","placement":{"id":"congress-needle-embed-label"}},{"hed":"<strong>Democrats on pace to win large House majority</strong>","paragraph":"Democrats will have a Senate majority of six or more seats. They won, or are favored to win, virtually every Senate battleground state.","placement":{"id":"congress-needle-embed"}},{"hed":"<strong>Democrats retake Congress with sweeping victories</strong>","paragraph":"Democrats are on track to win the largest House majority since the 2008 election and a Senate majority of several seats.","placement":{"type":"congress-needle-full"},"timestamp":"2026-11-04 1:45 AM"},{"paragraph":"Senate","placement":{"id":"senate-needle-win-prob-label"}},{"paragraph":"House","placement":{"id":"house-needle-win-prob-label"}},{"paragraph":"Control of Senate","placement":{"id":"senate-needle-small-win-prob-label"}},{"paragraph":"Control of House","placement":{"id":"house-needle-small-win-prob-label"}}]},"updated_at":"2026-11-04T06:51:45.700334+00:00"},{"name":"2026-11-03-global","contents":{"text":[{"paragraph":"See more results","placement":{"id":"footer-title"}},{"hed":"National Results","links":[{"text":"Senate","template":"general-overview-page"},{"text":"House","template":"general-overview-page"},{"text":"Governors","template":"general-overview-page"},{"link":"https://www.nytimes.com/interactive/2026/elections/voter-trends-national.html","text":"Voter Trends"},{"text":"Live Forecast","template":"general-model-overview-page"},{"link":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-senate-precinct-maps.html","text":"Precinct Maps"},{"link":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-key-ballot-measures.html","text":"Ballot Measures"}],"placement":{"type":"footer-link-strip"}},{"placement":{"id":"all-pages-banner"},"paragraphs":[{"hed":"","paragraph":""}]}]},"updated_at":"2026-11-05T13:34:15.626887+00:00"},{"name":"2026-11-03 Embeds","contents":{"text":[{"hed":"Senate results","placement":{"id":"bop-senate-hed","template":"general-liveblog"}},{"hed":"House results","placement":{"id":"bop-house-hed","template":"general-liveblog"}},{"hed":"Key races","placement":{"id":"2026-11-03-hp-strip-races","type":"race-strip-hed"}},{"hed":"Key races","placement":{"id":"2026-11-03-results-liveblog","type":"race-strip-hed"}},{"hed":"Key races","placement":{"id":"2026-11-03-panel-pop-races","type":"race-strip-hed"}},{"paragraph":"Source: A.P.","placement":{"id":"source-note-mobile"}},{"paragraph":"Source: Results and race calls from The Associated Press. County view shows margin of the leading candidate in the votes counted so far.","placement":{"id":"source-note-desktop"}},{"hed":"Key Senate races","placement":{"id":"senate-table-header"}},{"hed":"Key races","placement":{"id":"key-races-header"}},{"hed":"Full Senate results","placement":{"id":"map-promo"}},{"hed":"Tracking competitive House districts","paragraph":"Democrats have won their target number of competitive districts and are on track to win the House.","placement":{"id":"house-tracker"}},{"hed":"Live Election Results","placement":{"id":"article-embed-header"}},{"hed":"Full results","placement":{"id":"result-links-hed-mobile"}},{"hed":"Full results","placement":{"id":"result-links-hed-desktop"}},{"links":[{"text":"Senate","template":"general-overview-page"},{"text":"House","template":"general-overview-page"},{"text":"Governors","template":"general-overview-page"},{"link":"https://www.nytimes.com/interactive/2026/elections/voter-trends-national.html","text":"Trends","#text":"Live Forecast","#template":"general-model-overview-page"}],"placement":{"id":"embed-results-links"}}]},"updated_at":"2026-11-06T18:46:33.349147+00:00"}],"feeds":{"search":{"id":"f764fc52-8405-4ef4-b6cc-5b44ed38d840","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/f764fc52-8405-4ef4-b6cc-5b44ed38d840/search/2026-11-03.json","slug":"search","params":null,"polling_interval":null,"server_render_enabled":true,"initial_client_render_enabled":true},"state-nav":{"id":"ffd36b98-554a-44df-8dfe-e1a867748f00","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/ffd36b98-554a-44df-8dfe-e1a867748f00/state-nav/2026-11-03.json","slug":"state-nav","params":null,"polling_interval":null,"server_render_enabled":true,"initial_client_render_enabled":true},"trending-races":{"id":"0f26ed2f-d8ac-4db4-8d19-44427038fe41","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/0f26ed2f-d8ac-4db4-8d19-44427038fe41/trending-races/2026-11-03.json","slug":"trending-races","params":null,"polling_interval":10,"server_render_enabled":false,"initial_client_render_enabled":true},"gov-county-data":{"id":"11093529-3f1d-454e-aa6e-e63660cac1e7","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/11093529-3f1d-454e-aa6e-e63660cac1e7/gov-county-data/2026-11-03.json","slug":"gov-county-data","params":null,"polling_interval":60,"server_render_enabled":false,"initial_client_render_enabled":false},"sen-county-data":{"id":"67880e0c-9bb4-497c-ac46-cac705cf6270","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/67880e0c-9bb4-497c-ac46-cac705cf6270/sen-county-data/2026-11-03.json","slug":"sen-county-data","params":null,"polling_interval":60,"server_render_enabled":false,"initial_client_render_enabled":false},"reporter-updates":{"id":"08626805-1eca-4b41-ad34-5a1b15a62d9b","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/08626805-1eca-4b41-ad34-5a1b15a62d9b/reporter-updates/2026-11-03.json","slug":"reporter-updates","params":{"feed_url":"https://static01.nytimes.com/newsgraphics/storylines/feeds/2026-05-26/reporter-updates.json"},"polling_interval":10,"server_render_enabled":true,"initial_client_render_enabled":true},"storyline-nav-search":{"id":"6c641f6c-876c-4338-a17d-c0d6d9e95452","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/6c641f6c-876c-4338-a17d-c0d6d9e95452/storyline-nav-search/2026-11-03.json","slug":"storyline-nav-search","params":null,"polling_interval":60,"server_render_enabled":true,"initial_client_render_enabled":true},"storyline-nav-dropdown":{"id":"1e83a3dd-5c49-43d7-9ae0-0ee157739e22","url":"https://static01.nyt.com/elections-assets/pages/data/feeds/1e83a3dd-5c49-43d7-9ae0-0ee157739e22/storyline-nav-dropdown/2026-11-03.json","slug":"storyline-nav-dropdown","params":null,"polling_interval":60,"server_render_enabled":true,"initial_client_render_enabled":true}},"versions":[],"live_blog_updates":{"live_blogs":[{"url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms","active":false,"first_published":"2026-11-11T23:04:31.000Z","last_updated":"2026-11-13T14:24:49.416Z"},{"url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump","active":false,"first_published":"2026-11-06T13:00:28.000Z","last_updated":"2026-11-16T22:03:15.626Z"},{"url":"https://www.nytimes.com/live/2026/11/05/us/midterm-elections-democrats-trump","active":false,"first_published":"2026-11-05T13:01:38.000Z","last_updated":"2026-11-16T22:03:15.371Z"},{"url":"https://www.nytimes.com/live/2026/11/04/us/midterm-election-results-democrats","active":false,"first_published":"2026-11-04T09:35:56.000Z","last_updated":"2026-11-15T03:46:19.252Z"},{"url":"https://www.nytimes.com/live/2026/11/03/us/midterms-2026-election-day-trump","active":false,"first_published":"2026-11-03T10:00:47.000Z","last_updated":"2026-11-16T22:03:15.464Z"}],"updates":[{"live_blog_id":39,"uri":"nyt://reporterupdate/affb9411-15cb-5130-86d1-6b3249b61512","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/affb9411-15cb-5130-86d1-6b3249b61512","headline":"Update from Emily Cochrane","first_published":"2026-11-12T03:31:40.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"“In every decision I make, I will never forget the most important thing is Mississippi matters,” Colom concludes. “We did it.” The crowd is chanting “Mississippi Matters,” the Colom campaign slogan, after he wraps up his speech.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/f8ee6a66-343e-53df-9c3f-54132c3f91f0","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/f8ee6a66-343e-53df-9c3f-54132c3f91f0","headline":"Update from Emily Cochrane","first_published":"2026-11-12T03:28:13.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Colom credits Representative Bennie Thompson for helping push him to campaign more and reach people in Mississippi. Thompson, unlike some other senior lawmakers, easily swatted away a youthful primary challenger this year and has amassed a powerful network of Black Democrats in Mississippi. ","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":["H"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/cdf4ce2e-7a85-57ce-a916-200224ea90a7","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/cdf4ce2e-7a85-57ce-a916-200224ea90a7","headline":"Update from Jennifer Medina","first_published":"2026-11-12T03:23:15.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/jennifer-medina","displayName":"Jennifer Medina","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/02/20/multimedia/author-jennifer-medina/author-jennifer-medina-thumbLarge-v3.png","name":"thumbLarge"}]}],"sourceId":"100000005752715","__typename":"Image"}}],"body":[{"content":[{"text":"Colom is one of ","formats":[],"__typename":"TextInline"},{"text":"several history-making candidates to win office this year","formats":[{"url":"https://www.nytimes.com/2026/11/05/us/politics/midterms-identity-politics.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" -- in his case, the first Black senator elected in Mississippi in nearly 150 years. Others include Xavier Becerra and Gina Hinojosa, the first Hispanic governors elected in California and Texas, and Abdul El-Sayed, the first Muslim senator. But Colom spoke about his story more directly and more at length than many of them did on election night last week.","formats":[],"__typename":"TextInline"}]}],"states":["AZ","CA","MS","TX"],"office_ids":["G","H","S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/9b0b223a-96e4-5c6d-9e19-b9bd39700dc4","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/9b0b223a-96e4-5c6d-9e19-b9bd39700dc4","headline":"Update from Emily Cochrane","first_published":"2026-11-12T03:22:14.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"“I had the courage to believe in Mississippi,” Colom says. Many people in the state believed the math had been there for Democrats. It was a matter of the right candidate and the right environment to bring the equation together.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/bcfc5640-d6dc-5ca0-af80-d22eeba0a4c5","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/bcfc5640-d6dc-5ca0-af80-d22eeba0a4c5","headline":"Update from Emily Cochrane","first_published":"2026-11-12T03:15:12.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"It has not always been easy for Democrats to speak about faith, but Scott Colom is among those who have been comfortable this election season speaking openly about it. It is a central tenet of his campaign — especially, he says now, as he recounts struggling to get people to pay attention to his campaign.","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/af3acea3-5063-56fe-9c38-8accdbdeb133","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/af3acea3-5063-56fe-9c38-8accdbdeb133","headline":"Update from Emily Cochrane","first_published":"2026-11-12T03:12:37.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Scott Colom, based on the cheers, has taken the stage. I can’t see him because so many people are on their feet — “there he is,” one woman says behind me.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/3b86c9a7-f173-50a4-8ccc-245905c7c851","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/3b86c9a7-f173-50a4-8ccc-245905c7c851","headline":"Update from Emily Cochrane","first_published":"2026-11-12T03:12:22.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Representative Bennie Thompson is just the second Black lawmaker Mississippi has sent to the House since Reconstruction and has been its lone Democrat in Congress for years. “All my friends kept saying ‘I don’t know if the time is right,’ he says, sketching out the steep national skepticism Scott Colom faced. Now, he says, “I now have a partner in Washington.”","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["H"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/cd94ac5d-ce8b-545f-be1a-65e12bb39b53","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/cd94ac5d-ce8b-545f-be1a-65e12bb39b53","headline":"Update from Bayliss Wagner","first_published":"2026-11-12T02:54:56.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"More than 90 percent of Black voters in Mississippi cast ballots for Colom, ","formats":[],"__typename":"TextInline"},{"text":"according to Times Voter Trends","formats":[{"url":"https://www.nytimes.com/interactive/2026/elections/voter-trends-mississippi.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":". In contrast, Colom won 25 percent of white voters’ ballots. That group shifted 19 points leftward in comparison to the 2024 election, according to Times Voter Trends, when Republicans won white voters by a margin of 67 percentage points. Black voters shifted eight points leftward when compared to 2024.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/9e10de17-9d53-5b0e-91cb-3b0a0f09c771","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/9e10de17-9d53-5b0e-91cb-3b0a0f09c771","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:34:32.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"The Mississippi Republican Party has just put out a statement, with Mike Hurst, the chairman, saying, “Scott Colom ran a good campaign here in Mississippi, and I congratulate him on his victory.” He continued: “While elections may determine who holds public office, they do not define who we are as a people nor diminish the principles we hold dear. Tomorrow, the sun will rise over the same Mississippi we loved yesterday.”","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["G"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/cdbf5dba-3717-5306-bc4d-833d60f49c42","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/cdbf5dba-3717-5306-bc4d-833d60f49c42","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:26:31.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"“There are moments when the place and the occasion speak to one another. Tonight is one of those moments,” Dr. Corey Wiggins says. It is clear that the choice of Tougaloo for this speech was intentional, given its history in the Civil Rights movement, along with the Colom campaign’s emphasis on energizing college students across the state.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":[]},{"live_blog_id":39,"uri":"nyt://reporterupdate/2b416dd5-e53c-5c17-8b2e-0a455cfa814d","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/2b416dd5-e53c-5c17-8b2e-0a455cfa814d","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:25:40.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"The President of Tougaloo College is taking the stage now. ","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["G"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/849f71ce-f402-5587-8eae-ec5d2cb35167","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/849f71ce-f402-5587-8eae-ec5d2cb35167","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:25:34.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"The program is officially starting. ","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["G"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/053fbfda-4551-56c4-ac8c-fd841ae0ea40","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/053fbfda-4551-56c4-ac8c-fd841ae0ea40","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:21:40.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Colom’s family and friends are slowly making their way to their seats. Someone has passed out American flags that a few in the crowd are waving. ","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["H"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/fc006fff-2532-56f0-8660-4e7898c1e602","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/fc006fff-2532-56f0-8660-4e7898c1e602","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:16:39.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"The sign on the lectern reads “Picked Another Senator.” It’s a reference to a spot for Colom that became known as the “pick another protein” ad. It went viral after Senator Cindy Hyde-Smith, asked to address rising beef prices, admonished voters that they “have so many proteins to choose from.” (We interviewed the guy ","formats":[],"__typename":"TextInline"},{"text":"whose delivery of “I’d rather pick another senator”","formats":[{"url":"https://www.nytimes.com/2026/11/11/us/elections/scott-colom-mississippi-senate-protein-ad.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" helped the ad go viral.)","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/77008bbf-224f-54a7-bc3f-1408698326be","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/77008bbf-224f-54a7-bc3f-1408698326be","headline":"Update from Emily Cochrane","first_published":"2026-11-12T02:04:05.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"We expect Scott Colom to speak shortly at Tougaloo College, after winning his Senate election. It is a poignant moment for so many here, especially give the historic nature of his win and the legacy of the college as a haven and proving ground for civil rights leaders and Black officials.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/5da3b427-651f-526e-8ed0-3fd7ef20860a","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/5da3b427-651f-526e-8ed0-3fd7ef20860a","headline":"Update from Emily Cochrane","first_published":"2026-11-12T01:40:24.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Scott Colom has arrived at Tougaloo College and just stepped into the campus chapel, to cheers and applause. ","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/d246a594-159f-5618-8ee8-1e9b81ef2576","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/d246a594-159f-5618-8ee8-1e9b81ef2576","headline":"Update from Michael Goldberg","first_published":"2026-11-12T01:30:55.000Z","reporter_tagline":"Politics reporter for Mississippi Today, reporting from Jackson.","bylines":[{"bioUrl":"","displayName":"Michael Goldberg","promotionalMedia":null}],"body":[{"content":[{"text":"Amid exuberant celebrations by Democrats, Gov. Tate Reeves, a Republican, has offered his congratulations to Colom in a statement on social media. ","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":["G"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/1db27674-0985-51c0-94bf-167f88e513bf","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/1db27674-0985-51c0-94bf-167f88e513bf","headline":"Update from Emily Cochrane","first_published":"2026-11-12T01:20:45.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Students are welcoming people to Tougaloo College, steps from the historic chapel where civil rights leaders spoke, with a dance tunnel.","formats":[],"__typename":"TextInline"}]},{}],"states":[],"office_ids":[]},{"live_blog_id":39,"uri":"nyt://reporterupdate/4e6f6abd-2b1d-5902-adff-ecfde6b7e6ec","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/4e6f6abd-2b1d-5902-adff-ecfde6b7e6ec","headline":"Update from Emily Cochrane","first_published":"2026-11-12T01:19:11.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Outside the historic chapel at Tougaloo College, it’s standing room only ","formats":[],"__typename":"TextInline"},{"text":"—","formats":[],"__typename":"TextInline"},{"text":" all seats have been taken as people from across the city come to celebrate Scott Colom’s win. ","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/21998bec-6543-55f8-b43a-ff0e3f64b6bb","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/21998bec-6543-55f8-b43a-ff0e3f64b6bb","headline":"Update from Emily Cochrane","first_published":"2026-11-12T01:18:18.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"In recent days, students and Black leaders have gathered here for community and to receive updates about the lengthy effort to count votes. ","formats":[],"__typename":"TextInline"}]}],"states":[],"office_ids":[]},{"live_blog_id":39,"uri":"nyt://reporterupdate/29fbbf9e-09f2-5d66-a313-9aa9371a5079","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/29fbbf9e-09f2-5d66-a313-9aa9371a5079","headline":"Update from Emily Cochrane","first_published":"2026-11-12T01:17:53.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Tougaloo College is a private, historically Black college just outside Jackson. It was known as a haven for civil rights organizers during the movement. The civil-rights leaders including Fannie Lou Hamer and Medgar Evers spoke at its chapel. ","formats":[],"__typename":"TextInline"}]}],"states":[],"office_ids":[]},{"live_blog_id":39,"uri":"nyt://reporterupdate/cd43fc49-b9f1-5108-9db5-c6bbb7332b45","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/cd43fc49-b9f1-5108-9db5-c6bbb7332b45","headline":"Update from Emily Cochrane","first_published":"2026-11-12T00:48:12.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"The mood at Tougaloo College, a historically Black college that had served as a safe haven for civil rights leaders and activists, was exuberant. People were dancing to music, embracing and declaring, “Thank the Lord, we did it.”","formats":[],"__typename":"TextInline"}]},{}],"states":[],"office_ids":[]},{"live_blog_id":39,"uri":"nyt://reporterupdate/554b8461-a954-5eb3-bd8b-05b8eb2fd635","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/554b8461-a954-5eb3-bd8b-05b8eb2fd635","headline":"Update from Michael Goldberg","first_published":"2026-11-12T00:46:13.000Z","reporter_tagline":"Politics reporter for Mississippi Today, reporting from Jackson.","bylines":[{"bioUrl":"","displayName":"Michael Goldberg","promotionalMedia":null}],"body":[{"content":[{"text":"Terry Rogers II, 21, a senior studying political science at the historically Black Tougaloo College, spent Tuesday driving students in a college van between government offices to check on their ballots as the race remained uncalled. A day later, he was scrolling CNN when he saw the network called the race for Colom. He and a friend took a moment to cry.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“This is what we’ve been praying for, for years, for generations,” Rogers said. “This makes me want to continue to be a Mississippian. This makes me love my state even more than I already did.”","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"Many college-educated residents of Mississippi have fled the state over the years to seek jobs and more progressive environments in other states. Rogers said Colom’s triumph could help improve the state’s national image.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"As Rogers spoke to The New York Times, a fellow student came by and shouted at him: “He won! You see that? You see that?”","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/ed782dbf-2bdf-5b2d-92d2-4700beb51bf0","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/ed782dbf-2bdf-5b2d-92d2-4700beb51bf0","headline":"Update from Bayliss Wagner","first_published":"2026-11-12T00:43:30.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"Kentucky Gov. Andy Beshear said Scott Colom’s win in the Mississippi Senate race proves that Southern Democrats are resurging.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“For too long, Southern Democrats have been overlooked, left out, and even looked down upon — but we are on the rise,” he ","formats":[],"__typename":"TextInline"},{"text":"wrote in a post on X.","formats":[{"url":"https://x.com/AndyBeshearKY/status/2120665195324338204","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"}]},{}],"states":["KY","MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/e55606d7-c682-553d-962e-f064c5216f2a","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/e55606d7-c682-553d-962e-f064c5216f2a","headline":"Update from Bayliss Wagner","first_published":"2026-11-12T00:25:33.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"When President Donald Trump refused to accept the results of the 2020 presidential election, Senator Cindy Hyde-Smith was ","formats":[],"__typename":"TextInline"},{"text":"among a handful of senators","formats":[{"url":"https://www.nytimes.com/interactive/2021/01/07/us/elections/electoral-college-biden-objectors.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" who backed him up, ","formats":[],"__typename":"TextInline"},{"text":"voting to reject the results","formats":[{"url":"https://www.nytimes.com/2021/01/07/us/politics/republicans-against-certification.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" in Pennsylvania and Arizona in the early hours of Jan. 7, after Congress had reconvened in the aftermath of the attack on the Capitol the day before. Six years later, in her own election, she is conceding to a narrow loss.","formats":[],"__typename":"TextInline"}]},{}],"states":["AZ","MS","PA"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/523982bb-6eb2-5fd4-ad23-acb70f0bb3a3","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/523982bb-6eb2-5fd4-ad23-acb70f0bb3a3","headline":"Update from Theodore Schleifer","first_published":"2026-11-12T00:16:45.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/theodore-schleifer","displayName":"Theodore Schleifer","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2024/06/04/reader-center/author-teddy-schleifer/author-teddy-schleifer-thumbLarge-v6.png","name":"thumbLarge"}]}],"sourceId":"100000009503559","__typename":"Image"}}],"body":[{"content":[{"text":"There has been a lot of commentary after last week’s results about whether big donors can actually swing races. Sometimes, they can. Consider Steve Pajcic, a surprise Democratic donor who emerged in mid-October to spend at least $7 million to ","formats":[],"__typename":"TextInline"},{"text":"back four red-state Democratic Senate candidates","formats":[{"url":"https://www.nytimes.com/2026/10/14/us/politics/democratic-donor-senate-red-state-ads.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":". Those races were all long shots then. But with Colom’s victory tonight, three of them have now won. The fourth, Angie Nixon in Florida, came awfully close. That’s an enviable track record.","formats":[],"__typename":"TextInline"}]}],"states":["FL","MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/7cb54b6d-9cf3-5080-a09e-1d92c8338258","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/7cb54b6d-9cf3-5080-a09e-1d92c8338258","headline":"Update from Michael Goldberg","first_published":"2026-11-12T00:09:21.000Z","reporter_tagline":"Politics reporter for Mississippi Today, reporting from Jackson.","bylines":[{"bioUrl":"","displayName":"Michael Goldberg","promotionalMedia":null}],"body":[{"content":[{"text":"At a bar in downtown Jackson, Robert Morris, 37, sat on the patio and said the U.S. Senate election made history he never expected to witness as a lifelong resident of the Deep South. ","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“I never thought I’d see this in my lifetime and I’m glad I did. Being from the South, it’s always been very Republican. I never thought I’d see a Black president, never thought I’d see a Black senator, especially a Black senator from Mississippi,” Morris said. “Remember when Andre 3000 said the South has something to say? Well now Mississippi does. Everybody is paying attention to us, and we’re going to do things right.”","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/b7270599-47f5-524c-b1ff-19a57db680f2","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/b7270599-47f5-524c-b1ff-19a57db680f2","headline":"Update from Theodore Schleifer","first_published":"2026-11-12T00:07:48.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/theodore-schleifer","displayName":"Theodore Schleifer","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2024/06/04/reader-center/author-teddy-schleifer/author-teddy-schleifer-thumbLarge-v6.png","name":"thumbLarge"}]}],"sourceId":"100000009503559","__typename":"Image"}}],"body":[{"content":[{"text":"The Mississippi Senate race was one of the few where Democrats actually outspent Republicans on advertising. It was a relatively cheap battle, all told, with only about $22 million seen on the airwaves — but about 62 percent of that favored Colom over Hyde-Smith.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/c5834687-81fc-581d-bf8d-48c8bd22a6e0","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/c5834687-81fc-581d-bf8d-48c8bd22a6e0","headline":"Update from Bayliss Wagner","first_published":"2026-11-12T00:07:14.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"Hyde-Smith, the first woman to represent Mississippi in Congress, was first appointed to the Senate to fill a vacancy in April 2018. She had previously served as Mississippi’s commissioner of agriculture from 2012 to 2018. She also spent more than a decade in the State Senate, starting as a conservative Democrat in 2000 and ","formats":[],"__typename":"TextInline"},{"text":"converting to the Republican Party in 2010.","formats":[{"url":"https://dailyleader.com/2010/12/28/sen-hyde-smith-joins-republicans/","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/984c9257-af7e-5426-8955-2dc0b3d43ad4","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/984c9257-af7e-5426-8955-2dc0b3d43ad4","headline":"Update from Emily Cochrane","first_published":"2026-11-12T00:03:06.000Z","reporter_tagline":"Reporting from Jackson, Miss.","bylines":[{"bioUrl":"https://www.nytimes.com/by/emily-cochrane","displayName":"Emily Cochrane","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/11/28/multimedia/author-emily-cochrane/author-emily-cochrane-thumbLarge-v4.png","name":"thumbLarge"}]}],"sourceId":"100000006236469","__typename":"Image"}}],"body":[{"content":[{"text":"Scott Colom will be the third Black senator ever to represent Mississippi. The first two were chosen by the state legislature and served during Reconstruction. Colom will be the first Black senator chosen by voters.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/2701a15b-3b38-52c6-88ff-44949d2852c2","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/2701a15b-3b38-52c6-88ff-44949d2852c2","headline":"Update from Shane Goldmacher","first_published":"2026-11-12T00:02:23.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/shane-goldmacher","displayName":"Shane Goldmacher","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/07/27/multimedia/author-shane-goldmacher/author-shane-goldmacher-thumbLarge.png","name":"thumbLarge"}]}],"sourceId":"100000006029325","__typename":"Image"}}],"body":[{"content":[{"text":"The victory of Scott Colom means that at least 55 senators will be aligned with the Democratic Party next year, with the race in Alaska still uncalled. ","formats":[],"__typename":"TextInline"}]}],"states":["AK","MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/22d09aea-9844-5b68-bbfe-13d708d63003","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/22d09aea-9844-5b68-bbfe-13d708d63003","headline":"Update from Bayliss Wagner","first_published":"2026-11-11T23:54:31.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"Senator Cindy Hyde-Smith, a Mississippi Republican, conceded in a video posted to social media on Wednesday evening.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“While this is not the outcome we worked for or hoped for, I respect the decision of Mississippi voters,” Hyde-Smith ","formats":[],"__typename":"TextInline"},{"text":"said in the video","formats":[{"url":"https://www.facebook.com/reel/2185349725521858","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":". “I want to congratulate Scott Colom and wish him well as he takes on the tremendous responsibility of representing our great state.”","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"She said her campaign “worked tirelessly to ensure every legally cast vote was counted, and that the people of Mississippi received a fair and transparent election.”","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/2db74e4a-0ed5-5f1c-939d-f7ab75dd8e50","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/2db74e4a-0ed5-5f1c-939d-f7ab75dd8e50","headline":"Update from Jennifer Medina","first_published":"2026-11-11T23:50:24.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/jennifer-medina","displayName":"Jennifer Medina","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/02/20/multimedia/author-jennifer-medina/author-jennifer-medina-thumbLarge-v3.png","name":"thumbLarge"}]}],"sourceId":"100000005752715","__typename":"Image"}}],"body":[{"content":[{"text":"Derrick Johnson, the national president of the N.A.A.C.P., said in a statement that “Mississippi voters made history because they refused to be intimidated, discouraged, or counted out.” This year, the N.A.A.C.P. opened 11 field offices and registered more than 17,000 voters, he said. “Even in the face of efforts to remove voters from the rolls, attempts to intimidate voters and election officials, and bids to create fear around the electoral process, Mississippi voters showed up. They showed up for their communities, for their families, and for the future of their state. They reminded the nation that we the people have the power.”","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":[]},{"live_blog_id":39,"uri":"nyt://reporterupdate/ae3f8d3a-7a05-5f58-a64d-c61ad9d5f4fe","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/ae3f8d3a-7a05-5f58-a64d-c61ad9d5f4fe","headline":"Update from Theodore Schleifer","first_published":"2026-11-11T23:48:59.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/theodore-schleifer","displayName":"Theodore Schleifer","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2024/06/04/reader-center/author-teddy-schleifer/author-teddy-schleifer-thumbLarge-v6.png","name":"thumbLarge"}]}],"sourceId":"100000009503559","__typename":"Image"}}],"body":[{"content":[{"text":"Many will be able to claim some credit for the victory of Scott Colom. Among them are George and Alex Soros. The liberal mega-donors have been supporters of Colom since at least 2015, when the family donated about $900,000 to a PAC supporting Colom’s successful run for district attorney. The younger Soros ","formats":[],"__typename":"TextInline"},{"text":"hosted","formats":[{"url":"https://www.nytimes.com/2025/09/26/us/politics/trump-soros-foundations-donors.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" a fundraiser last year at his New York home for Colom, then very much a long-shot candidate. And a super PAC that spent for Colom, Fulcrum, received most of its money, $1 million, from the Soros family’s super PAC.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["M"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/10bec1a6-1945-51f0-8680-b91898e4b27a","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/10bec1a6-1945-51f0-8680-b91898e4b27a","headline":"Update from Campbell Robertson","first_published":"2026-11-11T23:44:18.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/campbell-robertson","displayName":"Campbell Robertson","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2019/11/05/reader-center/campbell-robertson/campbell-robertson-thumbLarge-v2.jpg","name":"thumbLarge"}]}],"sourceId":"100000006809404","__typename":"Image"}}],"body":[{"content":[{"text":"In post on social media, Randall Woodfin, the mayor of Birmingham, Ala., who is also a Black Democrat, congratulated Mr. Colom. “They said the South will rise again,” he wrote, “but they never said which South.”","formats":[],"__typename":"TextInline"}]}],"states":["AL","MS"],"office_ids":["M","S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/d216ffc6-1bc9-5d32-b53f-313dbbd910c6","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/d216ffc6-1bc9-5d32-b53f-313dbbd910c6","headline":"Update from Michael Goldberg","first_published":"2026-11-11T23:41:36.000Z","reporter_tagline":"Politics reporter for Mississippi Today, reporting from Jackson.","bylines":[{"bioUrl":"","displayName":"Michael Goldberg","promotionalMedia":null}],"body":[{"content":[{"text":"Representative Justis Gibbs, a Democratic state lawmaker, was at his Jackson law office when the race was called for Colom, who will become the first Black senator from Mississippi in nearly 150 years. Everyone stopped working and screamed for joy, he said.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“Scott Colom’s victory marks a true turning point for Mississippi,” said Gibbs, who is also Black. “Voters showed up and showed out! His authenticity on the campaign trail and remarkable ability to connect with Mississippians in both rural and urban communities have injected new energy and momentum into the Mississippi Democratic Party.”","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/cc15fdba-c7d4-54af-9dfd-e62a561d2345","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/cc15fdba-c7d4-54af-9dfd-e62a561d2345","headline":"Update from Bayliss Wagner","first_published":"2026-11-11T23:37:39.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"Before this week, no Democrat had won Mississippi’s Senate race since 1982, when Senator John C. Stennis won a seventh term. As a staunch segregationist, Stennis had been a member of an earlier iteration of the Democratic Party. He renounced those views toward the end of his career, in the early 1980s.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/0752a82f-1c05-5682-9127-0815607048b4","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/0752a82f-1c05-5682-9127-0815607048b4","headline":"Update from Bayliss Wagner","first_published":"2026-11-11T23:32:34.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"Scott Colom is currently ","formats":[],"__typename":"TextInline"},{"text":"leading Senator Cindy Hyde-Smith by 4,669 votes","formats":[{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-mississippi-us-senate.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" with around 99% of ballots counted, according to The Associated Press. His margin could change slightly, but the call means that The A.P. does not see a path to victory for Hyde-Smith.","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/4415ed97-e8d3-5a56-872b-0eac0108142f","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/4415ed97-e8d3-5a56-872b-0eac0108142f","headline":"Update from Jennifer Medina","first_published":"2026-11-11T23:31:24.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/jennifer-medina","displayName":"Jennifer Medina","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/02/20/multimedia/author-jennifer-medina/author-jennifer-medina-thumbLarge-v3.png","name":"thumbLarge"}]}],"sourceId":"100000005752715","__typename":"Image"}}],"body":[{"content":[{"text":"With the election of Colom, there will now be seven Black senators next year, the highest number in history. In addition to Colom, Julianna Stratton, the senator-elect from Illinois, will join Senators Angela Alsobrooks, Cory Booker, Lisa Blunt Rochester, Tim Scott and Raphael Warnock.","formats":[],"__typename":"TextInline"}]}],"states":["DE","IL","KY","NJ","TN","VA","VT","WA","WI","WV","WY"],"office_ids":["S"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/9fd673ef-762c-50bc-955f-8d30c3e70141","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/9fd673ef-762c-50bc-955f-8d30c3e70141","headline":"Update from Campbell Robertson","first_published":"2026-11-11T23:28:24.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/campbell-robertson","displayName":"Campbell Robertson","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2019/11/05/reader-center/campbell-robertson/campbell-robertson-thumbLarge-v2.jpg","name":"thumbLarge"}]}],"sourceId":"100000006809404","__typename":"Image"}}],"body":[{"content":[{"text":"U.S. Representative Bennie Thompson, until today Mississippi’s sole Black congressman, congratulated Colom in a statement, saying that his campaign “brought together Mississippians from every walk of life — young and old, black and white, rural and urban — in a way I have never witnessed in more than 50 years of public service.”","formats":[],"__typename":"TextInline"}]},{}],"states":["MS"],"office_ids":["H"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/e7d071bf-a0b5-5dce-b931-2783a489137e","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/e7d071bf-a0b5-5dce-b931-2783a489137e","headline":"Update from Jennifer Medina","first_published":"2026-11-11T23:28:05.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/jennifer-medina","displayName":"Jennifer Medina","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/02/20/multimedia/author-jennifer-medina/author-jennifer-medina-thumbLarge-v3.png","name":"thumbLarge"}]}],"sourceId":"100000005752715","__typename":"Image"}}],"body":[{"content":[{"text":"Senator Alex Padilla, a Democrat from California, connected Colom’s win to voting rights. “Just a few thousand votes made the difference,” the former California secretary of state wrote in a post on X. “Never let anyone tell you your vote doesn’t matter. That’s why they keep trying to go after our right to vote. When the people turn out, justice wins.”","formats":[],"__typename":"TextInline"}]}],"states":["CA"],"office_ids":["H"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/2494919f-219c-5580-8f56-1f7c07ffde0c","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/2494919f-219c-5580-8f56-1f7c07ffde0c","headline":"Update from Michael Kruse","first_published":"2026-11-11T23:20:12.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"","displayName":"Michael Kruse","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/02/reader-center/author-michael-kruse/author-michael-kruse-thumbLarge.png","name":"thumbLarge"}]}],"sourceId":"100000010941146","__typename":"Image"}}],"body":[{"content":[{"text":"Wilbur Colom, Scott Colom’s father, told The New York Times Wednesday that Hyde-Smith had gotten in touch with Colom’s team to concede the race.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["G"]},{"live_blog_id":39,"uri":"nyt://reporterupdate/2f3810ae-b327-5022-adfa-8b91c5a4750e","url":"https://www.nytimes.com/live/2026/11/11/us/mississippi-senate-election-midterms/2f3810ae-b327-5022-adfa-8b91c5a4750e","headline":"Update from Bayliss Wagner","first_published":"2026-11-11T23:06:43.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/bayliss-wagner","displayName":"Bayliss Wagner","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/06/11/reader-center/author-bayliss-wagner/author-bayliss-wagner-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010961854","__typename":"Image"}}],"body":[{"content":[{"text":"Senator Chuck Schumer, the Democratic minority leader, and Kirsten Gillibrand, who chairs the Senate Democratic campaign arm, congratulated Senator-elect Scott Colom for breaking the party’s more than 40-year drought in Mississippi Senate races on Wednesday evening.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“We will work hand in hand with Scott to fight for Mississippians’ health care, costs, and future in the 120th Congress and look forward to welcoming him to our caucus,” Schumer and Gillibrand, both of New York, said in a joint statement.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/ee6c252e-5edf-5e0f-89b4-9ed36f37651f","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/ee6c252e-5edf-5e0f-89b4-9ed36f37651f","headline":"Update from John Yoon","first_published":"2026-11-06T23:53:30.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/john-yoon","displayName":"John Yoon","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2021/04/09/reader-center/author-john-yoon/author-john-yoon-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000007700982","__typename":"Image"}}],"body":[{"content":[{"text":"Nancy Lacore, a Democratic former Navy admiral who was fired by Defense Secretary Pete Hegseth, flipped the South Carolina House seat held by Representative Nancy Mace, a Republican who ran unsuccessfully for governor instead of seeking re-election, according to The Associated Press.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"Lacore defeated Jenny Costa Honeycutt, a Republican who is an ally of President Trump’s, in a district that not only leans conservative but was restructured through gerrymandering to further favor Republicans.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"Democrats had eyed the seat in the First Congressional District, hoping that Lacore’s military background could be an asset. Her ouster as chief of the Navy Reserve during Hegseth’s broader purge of senior military leaders last year gave her a national profile, and Lacore said that her dismissal motivated her to run for office.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"Lacore has spoken in support of codifying Roe v. Wade in federal law, restoring expanded Medicaid benefits and imposing stricter oversight on Immigration and Customs Enforcement.","formats":[],"__typename":"TextInline"}]},{}],"states":["SC"],"office_ids":["H"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/1cdbb360-111a-5d17-926c-cae5f6744c82","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/1cdbb360-111a-5d17-926c-cae5f6744c82","headline":"Update from Tim Balk","first_published":"2026-11-06T22:34:17.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/tim-balk","displayName":"Tim Balk","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2024/06/14/reader-center/author-tim-balk/author-tim-balk-thumbLarge.png","name":"thumbLarge"}]}],"sourceId":"100000009522958","__typename":"Image"}}],"body":[{"content":[{"text":"Eliott Rodriguez, a South Florida Democrat whose race for the House remains ","formats":[],"__typename":"TextInline"},{"text":"too close to call","formats":[{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-florida-us-house-27.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":", filed a lawsuit on Friday in federal court in Miami requesting that the Miami-Dade County elections supervisor, Alina Garcia, recuse herself from any recount process in his race.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"The complaint cited a ","formats":[],"__typename":"TextInline"},{"text":"Miami Herald article that reported","formats":[{"url":"https://www.miamiherald.com/news/local/article317923781.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" Garcia said on election night that Representative María Elvira Salazar, the Republican incumbent, was the winner “with or without a recount.” The complaint also says that Garcia, who is also a Republican, and the congresswoman are friends.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"“We have an election supervisor who is crossing the lines,” Rodriguez said by phone. Garcia’s office and Salazar’s campaign did not immediately respond to requests for comment.","formats":[],"__typename":"TextInline"}]}],"states":["FL"],"office_ids":["H"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/3cfc42d2-7691-52c2-a370-efb09e55fad3","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/3cfc42d2-7691-52c2-a370-efb09e55fad3","headline":"Update from Evan Reynolds","first_published":"2026-11-06T21:27:01.000Z","reporter_tagline":"Election data reporter","bylines":[{"bioUrl":"https://www.nytimes.com/by/evan-reynolds","displayName":"Evan Reynolds","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/07/07/reader-center/author-evan-reynolds/author-evan-reynolds-thumbLarge.png","name":"thumbLarge"}]}],"sourceId":"100000011016177","__typename":"Image"}}],"body":[{"content":[{"text":"In the Mississippi Senate race, Scott Colom’s lead over Cindy Hyde-Smith, the Republican incumbent, grew to about 2,500 votes on Friday, according to The Associated Press, after three more counties reported votes around 4:10 p.m. Eastern. Colom’s margin has increased by nearly 700 votes today, though just under 1,500 new votes have been reported statewide.","formats":[],"__typename":"TextInline"}]}],"states":["MS"],"office_ids":["S"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/46708d9b-e36e-5667-ad8f-0fa977e98402","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/46708d9b-e36e-5667-ad8f-0fa977e98402","headline":"Update from Christine Zhang","first_published":"2026-11-06T21:18:07.000Z","reporter_tagline":null,"bylines":[{"bioUrl":"https://www.nytimes.com/by/christine-zhang","displayName":"Christine Zhang","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2024/04/25/reader-center/author-christine-zhang/author-christine-zhang-thumbLarge.png","name":"thumbLarge"}]}],"sourceId":"100000009434112","__typename":"Image"}}],"body":[{"content":[{"text":"The next batches of votes from ","formats":[],"__typename":"TextInline"},{"text":"Alaska","formats":[{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-alaska.html","title":"","__typename":"LinkFormat"}],"__typename":"TextInline"},{"text":" are expected to be posted on Monday and Tuesday, according to the state’s Division of Elections. These are expected to consist of ballots cast early in-person and by mail.","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"The remaining votes, mostly from mail-in ballots, have until Nov. 18 to be counted. At that time, ranked-choice tabulation would begin if the top candidates in the Senate, governor and House races have not received a majority of votes.","formats":[],"__typename":"TextInline"}]},{}],"states":["AK"],"office_ids":["G","H","S"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/9fb1e224-6e01-591c-bd87-f2cffe06b768","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/9fb1e224-6e01-591c-bd87-f2cffe06b768","headline":"Update from Lauren McGaughy","first_published":"2026-11-06T20:49:30.000Z","reporter_tagline":"Texas politics reporter","bylines":[{"bioUrl":"https://www.nytimes.com/by/lauren-mcgaughy","displayName":"Lauren McGaughy","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/03/18/arts/author-Lauren-McGaughy/author-Lauren-McGaughy-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010787356","__typename":"Image"}}],"body":[{"content":[{"text":"Senfronia Thompson, a Houston Democrat who has served in the Texas House for more than 50 years, just announced in the Texas State Capitol that she had enough votes to become speaker next year. Thompson said she would work with Republicans, who are now in the minority party for the first time in more than 20 years, when state lawmakers meet for their next session in January. “I do not have a dictatorship,” she said. ","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"Thompson, 87, would be the first Black speaker and first female speaker.","formats":[],"__typename":"TextInline"}]},{}],"states":["TX"],"office_ids":["H"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/1f682eac-2969-52f7-88eb-075549b032b4","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/1f682eac-2969-52f7-88eb-075549b032b4","headline":"Update from Lauren McGaughy","first_published":"2026-11-06T20:12:08.000Z","reporter_tagline":"Texas politics reporter","bylines":[{"bioUrl":"https://www.nytimes.com/by/lauren-mcgaughy","displayName":"Lauren McGaughy","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2026/03/18/arts/author-Lauren-McGaughy/author-Lauren-McGaughy-thumbLarge-v2.png","name":"thumbLarge"}]}],"sourceId":"100000010787356","__typename":"Image"}}],"body":[{"content":[{"text":"In the Texas Capitol today, Senfronia Thompson, who has been in the State House since 1973, will announce she has more than enough support to become speaker. The Texas House press room is packed with lawmakers, staff members and members of the news media awaiting the announcement. ","formats":[],"__typename":"TextInline"}]},{"content":[{"text":"Thompson, known affectionately as “Miss T,” would be the first Black speaker in the state. This week’s blue sweep across Texas gave Democrats control of the Texas House for the first time since 2003.","formats":[],"__typename":"TextInline"}]},{}],"states":["TX"],"office_ids":["H"]},{"live_blog_id":38,"uri":"nyt://reporterupdate/7ae27882-4631-5d20-af0c-49698c077593","url":"https://www.nytimes.com/live/2026/11/06/us/midterm-elections-trump/7ae27882-4631-5d20-af0c-49698c077593","headline":"Update from David Chen","first_published":"2026-11-06T19:11:11.000Z","reporter_tagline":"National reporter","bylines":[{"bioUrl":"","displayName":"David Chen","promotionalMedia":{"crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2018/02/16/multimedia/author-david-w-chen/author-david-w-chen-thumbLarge-v3.png","name":"thumbLarge"}]}],"sourceId":"100000005746130","__typename":"Image"}}],"body":[{"content":[{"text":"Arizona Democrats have won the State Senate and State House of Representatives, according to The Associated Press. Coupled with Gov. Katie Hobbs’s re-election victory, Democrats will now have a trifecta — both legislative chambers and the governor’s office — for the first time since the mid-1960s. In fact, the Democrats have not had an outright majority in any legislative chamber in Arizona since the early 1990s.","formats":[],"__typename":"TextInline"}]},{}],"states":["AZ"],"office_ids":["G","H"]}]},"related_assets":null,"links":[{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-governor.html","template":"general-overview-page","states":[],"offices":["Governor"],"collection_name":null},{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-senate.html","template":"general-overview-page","states":[],"offices":["U.S. Senate"],"collection_name":null},{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-needle-senate-house-forecast.html","template":"general-model-overview-page","states":[],"offices":["U.S. House","U.S. Senate"],"collection_name":null},{"url":"https://www.nytimes.com/interactive/2026/11/06/us/elections/results-senate-governor-house-flips.html","template":"general-dashboard-page","states":[],"offices":["U.S. Senate","Governor","U.S. House"],"collection_name":null},{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-key-ballot-measures.html","template":"general-collection-page","states":[],"offices":[],"collection_name":null},{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-house.html","template":"general-overview-page","states":[],"offices":["U.S. House"],"collection_name":null},{"url":"https://www.nytimes.com/interactive/2026/11/03/us/elections/results-house-races-tracker.html","template":"general-house-race-tracker-page","states":[],"offices":["U.S. House"],"collection_name