  query getOnsiteMessaging($data: OnsiteMessagingInput!) {
    onsiteMessaging(data: $data){
      version
      input {
        country
        continent
        debug
        deviceType
        name
        pageViewID
        canUseApplePay
        canUseGooglePay
        isGamesHybridWebView 
        url
        uri
        now
        referrer
        production
        language
        gamesSourceApp
        oesPreview
        regiID
      }
      responses {
        abra {
          error
          data {
            test
            variant
            integration
          }
        }
        meter {
          error
          data {
            meter
            viewed
            counted
            gateway
            granted
            section
            version
            abTests {
              name
              variation
            }
            statsig {
              name
              kind
              parameter
              value
            }
            loggedIn
            regiwall
            assetType
            countable
            threshold
            hitPaywall
            gatewayType
            grantReason
            hitRegiwall
            rulesVersion
            gatewayExempt
            gatewayEligible
            nytsNeedsRefresh
            gatewayTypeVariation
            peek
            region
            extendedAccess {
              signedEntitlements
              regiHash
              registrationTimestamp
            }
            extraData {
              key
              value
            }
            accessDecisionRule
            gatewayTypeRule
            gatewayTypeVariationRule
            accessDecisionRuleGroup
            overrideError
            algoDecision
          }
        }
        offerEligibility {
          error
          data {
            strategy {
              programs {
                name
                available
                reason
                initiatives {
                  name
                  available
                  reason
                  iterations {
                    available
                    reason
                    scenarios {
                      offer
                      available
                      reason
                    }
                  }
                }
              }
              datasources {
                billingCountry
              }
            }
            ...OfferEligibilityRules
          }
        }
        subInfo {
          error
          data {
            subscriptionID
            products
            status
          }
        }
        algoEverything {
          error
          data {
            meta {
              surfaceNames
              units
            }
            surfaces {
              meta {
                surface
                count
                algo
              }
              items {
                uri
              }
            }
          }
        }
        statsig {
          error
          data {
            name
            parameter
            type
            value
            reason
          }
          statsigUser
          initializeResponse
        }
        userSettings {
          error
          useUserSettings
          data {
            user {
              setting {
                oma {
                  storyblock {
                    viewcount { value }
                    dismissed { value }
                  }
                  bottomsheet {
                    viewcount { value }
                    dismissed { value }
                  }
                  getstartedlater {
                    viewcount { value }
                    dismissed { value }
                  }
                  getstartednow {
                    viewcount { value }
                    dismissed { value }
                  }
                  sharelinktooltipweb {
                    viewcount { value }
                    dismissed { value }
                  }
                  sharelinktooltipapp {
                    viewcount { value }
                    dismissed { value }
                  }
                  liveonboardingblock {
                    viewcount { value }
                    dismissed { value }
                  }
                  savedarticletooltip {
                    viewcount { value }
                    dismissed { value }
                  }
                  cooksharelinktooltipweb {
                    viewcount { value }
                    dismissed { value }
                  }
                  stickygifttestweb {
                    viewcount { value }
                    dismissed { value }
                  }
                  synthvoicetestweb {
                    viewcount { value }
                    dismissed { value }
                  }
                  emailsignupdock {
                    viewcount { value }
                    dismissed { value }
                  }
                  targetednewslettersignup {
                    viewcount { value }
                    dismissed { value }
                  }
                  disrupterreadinappdock {
                    viewcount { value }
                    dismissed { value }
                  }
                  welcomebannerregi {
                    viewcount { value }
                    dismissed { value }
                  }
                  messagecaps {
                    key
                    unit { value }
                    campaign { value }
                    audience { value }
                    viewcount { value }
                    dismissed { value }
                  }
                }
                onboardcorenews {
                  flow {
                    completed { value }
                    started { value }
                  }
                }
              }
            }
          }
        }
        sales {
          error
          data {
            name
            isActive
            activeContent
            activePhase {
              copy
              theme
              mobileCopy
            }
          }
        }
      }
      units {
        name
        canShow
        reason
        tests {
          test
          statsigExperiment {
            name
            parameter
            value
          }
        }
        messages {
          name
          audience
          canShow
          reason
          selected
          intents
          algoEverythingSurfaceSuffix
          algoEverythingSurface
          isControl
          rank
          tests {
            test
            statsigExperiment {
              name
              parameter
              value
            }
          }
          staticContent {
            name
            value
            type
            reason
          }
          eligibleMessages {
            name
            audience
          }
        }
      }
    }
  }
