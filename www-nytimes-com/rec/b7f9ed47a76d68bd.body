p.generated-text.eln-y2dexy{margin:0;line-height:1.3;color:var(--text-color-secondary)}p.generated-text.style-body.eln-y2dexy{font-family:var(--font-family-body, var(--font-family-serif));font-size:var(--font-size);color:var(--text-color-secondary);margin-bottom:calc(var(--spacing) * 2)}p.generated-text.style-sans.eln-y2dexy{font-family:var(--font-family-sans);font-size:16px}p.generated-text.style-caption.eln-y2dexy{font-family:var(--font-family-sans);font-size:var(--font-sm);line-height:1.3}p.generated-text.style-leadin.eln-y2dexy{font-family:var(--font-family-sans);font-size:16px;font-weight:var(--font-normal)}p.generated-text.style-imperial.eln-y2dexy{font-family:var(--font-family-body);font-size:16px;line-height:22px;color:var(--text-color-secondary)}@media(min-width:764px){p.generated-text.style-imperial.eln-y2dexy{font-size:20px;line-height:27px}}p.generated-text.style-chelt.eln-y2dexy{font-family:var(--font-family-base);color:var(--gray-35);font-size:20px;line-height:1.15;font-weight:var(--font-light)}@media(min-width:764px){p.generated-text.style-chelt.eln-y2dexy{font-size:22px}}p.generated-text.style-headline.eln-y2dexy{font-family:var(--font-family-base);font-size:20px;font-weight:600;line-height:1.15}.race-call-check.eln-y2dexy{display:inline-flex;align-items:center;vertical-align:-.12em;margin-right:.3em;line-height:1}.part.eln-y2dexy{color:var(--part-color, inherit)}.part.bold.eln-y2dexy{font-weight:var(--font-bold)}.part.italic.eln-y2dexy{font-style:italic}.generated-text-link.eln-y2dexy{display:block;margin-top:calc(var(--spacing) * 1)}.generated-text-link.inline.eln-y2dexy{display:inline;margin-top:0;text-wrap:nowrap}.generated-text.shimmer-all.eln-y2dexy{background:linear-gradient(105deg,#fff0 0% 40%,#ffffff73 50%,#fff0 60% 100%),linear-gradient(currentColor,currentColor);background-size:200% 100%,100% 100%;background-position:130% 50%,0 0;background-repeat:no-repeat,no-repeat;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:eln-y2dexy-generated-text-shimmer 4.6s cubic-bezier(.4,0,.2,1) infinite}.shimmer-part.eln-y2dexy{background:linear-gradient(105deg,#fff0 0% 45%,#ffffff59 48.5%,#ffffffbf,#ffffff59 51.5%,#fff0 55% 100%),linear-gradient(var(--part-color, currentColor),var(--part-color, currentColor));background-size:200% 100%,100% 100%;background-position:130% 50%,0 0;background-repeat:no-repeat,no-repeat;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:eln-y2dexy-generated-text-shimmer 4.6s cubic-bezier(.4,0,.2,1) infinite}@keyframes eln-y2dexy-generated-text-shimmer{0%,35%{background-position:130% 50%,0 0}74%,to{background-position:-30% 50%,0 0}}
