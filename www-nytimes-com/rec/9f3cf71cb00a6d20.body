  fragment onWatchFeed on CardDeck {
    __typename
    id
    asset {
      ... on WatchTab {
        cards {
          altText
          bylinesText
          label
          callToActionText
          callToActionUrl
          callToActionAsset {
            ... on Node {
              id
            }
            ... on Published {
              url
            }
          }
          assets {
            headline {
              default
            }
            ... on Image {
              __typename
              id
              crops(renditionNames: ["articleLarge"]) {
                name
                __typename
                renditions {
                  name
                  url
                  width
                  height
                  __typename
                }
              }
            }
            ... on Video {
              __typename
              id
              uri
              url
              summary
              transcript
              sourceId
              duration
              language {
                code
              }
              renditions @filterEmpty {
                aspectRatio
                type
                url
                width
                height
              }
              isCinemagraph
              promotionalMedia {
                ... on Image {
                  id
                  credit
                  altText
                  crops(renditionNames: ["verticalTwoByThree735", "smallTwoByThree", "articleLarge", "jumbo"]) {
                    name
                    renditions {
                      name
                      url
                      width
                      height
                    }
                  }
                }
              }
            }
          }

          data
          key
          text {
            key
            content {
              __typename
              ... on LineBreakInline {
                type
              }
              ... on TextInline {
                text
                formats {
                  __typename
                  ... on BoldFormat {
                    type
                  }
                  ... on ItalicFormat {
                    type
                  }
                  ... on LinkFormat {
                    title
                    url
                    uri
                  }
                }
              }
            }
          }
        }
      }
    }
  }
