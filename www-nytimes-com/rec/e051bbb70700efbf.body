  query getShareInfo($id: String!) {
    article: anyWork(id: $id) {
      ... on CreativeWork {
        headline {
          default
        }
        summary
      }
      ... on Published {
        uri
        url
      }
    }
  }
`,De=r`
  mutation CreateShare($input: CreateShareInput!) {
    createShare(input: $input) {
      success
      message
      share {
        id
        shareTime
        platform
      }
    }
